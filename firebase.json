{
  "hosting": [
    {
      "target": "app",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*"],
      "trailingSlash": true,
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "bgm",
      "public": "bgm/public",
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "**/*.@(mp3|m4a|ogg|opus|webm)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ]
    }
  ]
}
