// icons/*.ts에 더한 아이콘도 함께 쓴다(세션마다 자기 파일에 더해서 서로 부딪히지 않게).
const extra = import.meta.glob<Record<string, string>>('./icons/*.ts', { eager: true, import: 'default' });
for (const [file, set] of Object.entries(extra)) {
  for (const [k, v] of Object.entries(set)) {
    if (k in ICONS && ICONS[k] !== v) throw new Error(`아이콘 이름이 겹친다: ${k} (${file})`);
    ICONS[k] = v;
  }
}
const body = ICONS[name];
if (!body) throw new Error(`아이콘 없음: ${name}`);
---
<svg
  class="icon"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>
