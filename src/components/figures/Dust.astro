---
/**
 * 배경에 천천히 떠오르는 먼지. 꾸밈이라 읽기 프로그램에는 숨긴다.
 * 화면에 보일 때만 움직이고, 움직임을 줄이는 설정이면 멈춘 그림 한 장만 그린다.
 */
interface Props {
  count?: number;
}
const { count = 42 } = Astro.props;
---
<qm-dust class="dust" data-count={count} aria-hidden="true"><canvas></canvas></qm-dust>

<script>
  interface Mote {
    x: number;
    y: number;
    r: number;
    vy: number;
    sway: number;
    phase: number;
    warm: boolean;
    a: number;
  }

  class QmDust extends HTMLElement {
    private raf = 0;
    private motes: Mote[] = [];
    private io: IntersectionObserver | null = null;
    private visible = false;
    private w = 0;
    private h = 0;
    private onResize = () => this.resize();

    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      this.resize();
      const n = Number(this.dataset.count) || 42;
      this.motes = Array.from({ length: n }, () => this.spawn(true));
      window.addEventListener('resize', this.onResize);
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) {
        this.draw(ctx, 0);
        return;
      }
      this.io = new IntersectionObserver(([e]) => {
        this.visible = !!e?.isIntersecting;
        if (this.visible && !this.raf) this.loop(ctx);
      });
      this.io.observe(this);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.raf);
      this.raf = 0;
      this.io?.disconnect();
      window.removeEventListener('resize', this.onResize);
    }

    private resize() {
      const canvas = this.querySelector('canvas')!;
      const rect = this.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.w = rect.width;
      this.h = rect.height;
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      canvas.getContext('2d')?.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    private spawn(anywhere: boolean): Mote {
      return {
        x: Math.random() * this.w,
        y: anywhere ? Math.random() * this.h : this.h + 6,
        r: 0.5 + Math.random() * 1.4,
        vy: 4 + Math.random() * 10,
        sway: 6 + Math.random() * 14,
        phase: Math.random() * Math.PI * 2,
        warm: Math.random() < 0.45,
        a: 0.08 + Math.random() * 0.28,
      };
    }

    private loop(ctx: CanvasRenderingContext2D) {
      let last = performance.now();
      const step = (now: number) => {
        if (!this.visible || document.hidden) {
          this.raf = 0;
          return;
        }
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        for (const m of this.motes) {
          m.y -= m.vy * dt;
          m.phase += dt * 0.6;
          if (m.y < -6) Object.assign(m, this.spawn(false));
        }
        this.draw(ctx, now / 1000);
        this.raf = requestAnimationFrame(step);
      };
      this.raf = requestAnimationFrame(step);
    }

    private draw(ctx: CanvasRenderingContext2D, t: number) {
      ctx.clearRect(0, 0, this.w, this.h);
      for (const m of this.motes) {
        const x = m.x + Math.sin(m.phase) * m.sway;
        const flicker = 0.75 + 0.25 * Math.sin(t * 1.3 + m.phase * 3);
        ctx.fillStyle = m.warm ? `rgba(231, 145, 58, ${m.a * flicker})` : `rgba(236, 230, 217, ${m.a * flicker * 0.8})`;
        ctx.beginPath();
        ctx.arc(x, m.y, m.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }
  }
  if (!customElements.get('qm-dust')) customElements.define('qm-dust', QmDust);
</script>

<style>
  .dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .dust canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
