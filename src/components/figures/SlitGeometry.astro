---
/** 이중 슬릿의 기하: 두 슬릿에서 화면의 한 점까지 가는 두 길과 그 차이(경로차 = d sin θ). step으로 단계별 표시. */
---
<figure class="slitgeo">
  <svg viewBox="0 0 480 270" role="img" aria-label="두 슬릿에서 화면 위 한 점까지 가는 두 빛의 길. 아래 슬릿에서 온 빛의 길이 d sin θ만큼 더 길어요.">
    <defs>
      <marker id="sg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" class="sg-fill" />
      </marker>
    </defs>
    <!-- 슬릿 판 -->
    <rect x="96" y="20" width="6" height="88" class="sg-wall" />
    <rect x="96" y="118" width="6" height="34" class="sg-wall" />
    <rect x="96" y="162" width="6" height="88" class="sg-wall" />
    <text x="72" y="117" class="sg-t">S₁</text>
    <text x="72" y="161" class="sg-t">S₂</text>
    <!-- d -->
    <line x1="84" y1="113" x2="84" y2="157" class="sg-dim" />
    <text x="62" y="140" class="sg-t sg-space">d</text>
    <!-- 화면 -->
    <line x1="440" y1="20" x2="440" y2="250" class="sg-screen" />
    <text x="446" y="262" class="sg-s">화면</text>
    <!-- 가운데 선 -->
    <line x1="99" y1="135" x2="440" y2="135" class="sg-mid" />
    <!-- 두 길 -->
    <g data-step="2">
      <line x1="99" y1="113" x2="440" y2="48" class="sg-ray" marker-end="url(#sg-arrow)" />
      <line x1="99" y1="157" x2="440" y2="48" class="sg-ray sg-ray2" marker-end="url(#sg-arrow)" />
      <circle cx="440" cy="48" r="4" class="sg-pt" />
      <text x="392" y="40" class="sg-s">화면 위 한 점 P</text>
    </g>
    <!-- 경로차 삼각형 -->
    <g data-step="3">
      <line x1="99" y1="113" x2="111.8" y2="152.9" class="sg-perp" />
      <line x1="99" y1="157" x2="111.8" y2="152.9" class="sg-diff" />
      <text x="112" y="182" class="sg-s sg-accent">경로차 = d sin θ</text>
    </g>
    <!-- 각도 -->
    <g data-step="4">
      <line x1="99" y1="135" x2="440" y2="48" class="sg-mid" />
      <path d="M 160 135 A 61 61 0 0 0 158.1 119.9" class="sg-arc" />
      <text x="166" y="128" class="sg-t sg-time">θ</text>
      <text x="250" y="152" class="sg-s">화면까지 거리 L</text>
    </g>
  </svg>
</figure>

<style>
  .slitgeo {
    margin: 0;
    width: 100%;
    max-width: 500px;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .sg-wall {
    fill: var(--text-2);
  }

  .sg-screen {
    stroke: var(--text-2);
    stroke-width: 3;
  }

  .sg-mid {
    stroke: var(--muted);
    stroke-dasharray: 4 5;
  }

  .sg-dim {
    stroke: var(--q-space);
    stroke-width: 1.5;
  }

  .sg-ray {
    stroke: var(--q-energy);
    stroke-width: 1.8;
  }

  .sg-ray2 {
    stroke-dasharray: 6 3;
  }

  .sg-fill {
    fill: var(--q-energy);
  }

  .sg-pt {
    fill: var(--accent);
  }

  .sg-perp {
    stroke: var(--muted);
    stroke-dasharray: 2 3;
  }

  .sg-diff {
    stroke: var(--accent);
    stroke-width: 4;
  }

  .sg-arc {
    fill: none;
    stroke: var(--q-time);
    stroke-width: 1.5;
  }

  text {
    font-family: var(--font-body);
    fill: var(--text);
  }

  .sg-t {
    font-size: 15px;
  }

  .sg-s {
    font-size: 12px;
    fill: var(--text-2);
  }

  .sg-space {
    fill: var(--q-space);
  }

  .sg-time {
    fill: var(--q-time);
  }

  .sg-accent {
    fill: var(--accent);
  }
</style>
