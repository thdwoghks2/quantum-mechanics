---
/**
 * 2~4칸 비교 그림. 칸마다 아이콘(또는 큰 글자)과 짧은 설명.
 * 시간 변화(켠 직후 / 2분 뒤 / 5분 뒤)나 서로 다른 일상 예를 나란히 보여줄 때 쓴다.
 */
import Icon from './Icon.astro';
import { renderMath } from '../../lib/math.ts';

interface Panel {
  icon?: string;
  big?: string;
  title?: string;
  caption: string;
  tone?: 'accent' | 'dim' | 'ok' | 'no';
  step?: number;
}
interface Props {
  panels: Panel[];
  arrows?: boolean;
}
const { panels, arrows = false } = Astro.props;
---
<div class:list={['panels', { 'panels--arrows': arrows }]} style={`--n:${panels.length}`}>
  {panels.map((p) => (
    <div class:list={['panel', p.tone && `panel--${p.tone}`]} data-step={p.step}>
      {p.icon && <Icon name={p.icon} size={56} />}
      {p.big && <p class="panel__big" set:html={renderMath(p.big)} />}
      {p.title && <p class="panel__title" set:html={renderMath(p.title)} />}
      <p class="panel__cap" set:html={renderMath(p.caption)} />
    </div>
  ))}
</div>

<style>
  .panels {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    max-width: 520px;
  }

  @media (max-width: 380px) {
    .panels {
      grid-template-columns: repeat(min(var(--n), 2), minmax(0, 1fr));
    }
  }

  .panel {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 8px;
    padding: 16px 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    color: var(--text-2);
    text-align: center;
  }

  .panels--arrows .panel + .panel::before {
    content: '→';
    position: absolute;
    left: -11px;
    top: 34px;
    color: var(--muted);
    font-size: 14px;
  }

  .panel--accent {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    background: linear-gradient(180deg, rgba(231, 145, 58, 0.09), var(--ink-2) 70%);
    box-shadow: 0 18px 44px -22px rgba(231, 145, 58, 0.45);
  }

  .panel--accent :global(.icon) {
    filter: drop-shadow(0 0 10px rgba(231, 145, 58, 0.45));
  }

  .panel--accent .panel__big {
    color: var(--accent-2);
  }

  .panel--ok {
    color: var(--ok);
  }

  .panel--no {
    color: var(--no);
  }

  .panel--dim {
    opacity: 0.6;
  }

  .panel__big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--panel-big, clamp(1.45rem, 6.5vw, 1.85rem));
    color: var(--text);
    line-height: 1.2;
  }

  .panel__title {
    font-weight: 600;
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  .panel__cap {
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--text-2);
  }
</style>
