---
/**
 * 숫자 하나를 크게 보여주는 시각 자료. 위에 작은 설명, 아래에 비교 문장.
 * 화면이 열릴 때 숫자가 0부터 세어지며 올라간다. 숫자가 하나뿐이고 2 이상일 때만 센다.
 * 연도(1000~2100의 네 자리 정수), 식, 위 첨자가 있는 값은 세지 않고 천천히 밝아지기만 한다.
 * count={false}로 끌 수 있고, 움직임을 줄이는 설정이면 세지 않는다.
 */
import { hasMath, renderMath } from '../../lib/math.ts';
type Q = 'time' | 'space' | 'motion' | 'force' | 'energy' | 'charge' | 'heat' | 'plain';
interface Props {
  value: string;
  top?: string;
  bottom?: string;
  q?: Q;
  count?: boolean;
}
const { value, top, bottom, q = 'plain', count = true } = Astro.props;
// 값에 수식($…$)이 있으면 KaTeX로 그리고 세지 않는다.
const math = hasMath(value);
---
<qm-bignum class="bignum" data-q={q} data-count={count && !math ? '1' : '0'}>
  {top && <p class="bignum__top" set:html={renderMath(top)} />}
  {math ? <p class="bignum__value" set:html={renderMath(value)} /> : <p class="bignum__value">{value}</p>}
  {bottom && <p class="bignum__bottom" set:html={renderMath(bottom)} />}
</qm-bignum>

<script>
  import { prefersReducedMotion } from '../../lib/client/bus.ts';
  import { countable } from '../../lib/count.ts';

  class QmBignum extends HTMLElement {
    raf = 0;
    connectedCallback() {
      if (this.dataset.bound) return;
      this.dataset.bound = '1';
      const el = this.querySelector<HTMLElement>('.bignum__value')!;
      const plan = this.dataset.count === '1' ? countable(el.textContent ?? '') : null;
      if (!plan) return;
      const screen = this.closest('.screen');
      const run = () => {
        if (prefersReducedMotion()) return;
        cancelAnimationFrame(this.raf);
        const start = performance.now();
        const dur = 1500;
        const step = (now: number) => {
          const k = Math.min(1, (now - start) / dur);
          const e = 1 - Math.pow(1 - k, 3);
          el.textContent = plan.render(plan.target * e);
          if (k < 1) this.raf = requestAnimationFrame(step);
          else el.textContent = plan.text;
        };
        this.raf = requestAnimationFrame(step);
      };
      screen?.addEventListener('qm:show', run);
      if (!screen || screen.classList.contains('is-active')) run();
    }
    disconnectedCallback() {
      cancelAnimationFrame(this.raf);
    }
  }
  if (!customElements.get('qm-bignum')) customElements.define('qm-bignum', QmBignum);
</script>

<style>
  .bignum {
    display: grid;
    gap: 12px;
    padding: 10px 0;
    justify-items: center;
    text-align: center;
    max-width: 460px;
  }

  .bignum__top,
  .bignum__bottom {
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .bignum__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--bignum-size, clamp(2.2rem, 9.5vw, 3.2rem));
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-shadow: 0 0 36px rgba(242, 180, 107, 0.14);
    color: var(--qc, var(--text));
    font-variant-numeric: tabular-nums;
    text-wrap: balance;
  }

  :global(html.js .screen.is-active) .bignum__value {
    animation: bignum-in 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes bignum-in {
    from {
      opacity: 0;
      filter: blur(8px);
      letter-spacing: 0.04em;
    }
  }
</style>
