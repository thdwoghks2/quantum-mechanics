---
/**
 * 42·43·45강: 빛을 진동수에 따라 나눈 스펙트럼. 가로축은 진동수이고 오른쪽으로 갈수록 커진다.
 * 백열전구(이어진 띠), 수소·헬륨·나트륨·네온·수은(밝은 선), 햇빛(이어진 띠 위의 검은 선)을 고른다.
 * labels를 켜면 수소 선 위에 진동수를 적고, 선들이 다가가는 끝(계열의 한계)을 점선으로 보인다.
 */
interface Props {
  /** 보일 광원 (쉼표로): lamp, h, he, na, ne, hg, sun */
  sources?: string;
  /** 처음 고른 광원 */
  start?: string;
  /** 수소 선의 진동수와 한계를 적을지 */
  labels?: boolean;
}
const { sources = 'lamp,h,he,na,ne', start, labels = false } = Astro.props;
const NAMES: Record<string, string> = { lamp: '백열전구', h: '수소', he: '헬륨', na: '나트륨', ne: '네온', hg: '형광등(수은)', sun: '햇빛' };
const IDX: Record<string, number> = { lamp: 0, h: 1, he: 2, na: 3, ne: 4, hg: 5, sun: 6 };
const list = sources.split(',').map((s) => s.trim());
const first = IDX[start ?? list[0]!] ?? 0;
---
<qm-sim-spectrum class="sim" data-ratio="0.5" data-labels={labels ? '1' : '0'}>
  <canvas aria-label="빛을 진동수에 따라 늘어놓은 띠. 가로축은 진동수이고 오른쪽으로 갈수록 크다. 원소의 기체는 어두운 바탕에 몇 개의 밝은 선만, 햇빛은 무지개 띠 위에 검은 선을 보인다."></canvas>
  <input type="hidden" data-param="s" value={first} />
  <div class="sim__buttons" aria-label="광원 고르기">
    {list.map((k) => (
      <button type="button" class="btn" data-set={`s=${IDX[k]}`} aria-pressed={IDX[k] === first ? 'true' : 'false'}>{NAMES[k]}</button>
    ))}
  </div>
  <p class="sim__readout"></p>
</qm-sim-spectrum>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  /** 진동수(조 Hz)를 대략의 색으로 바꾼다. */
  function rgb(thz: number): [number, number, number] {
    const nm = 299792 / thz;
    let r = 0;
    let g = 0;
    let b = 0;
    if (nm < 440) [r, g, b] = [Math.max(0, -(nm - 440) / 60), 0, 1];
    else if (nm < 490) [r, g, b] = [0, (nm - 440) / 50, 1];
    else if (nm < 510) [r, g, b] = [0, 1, -(nm - 510) / 20];
    else if (nm < 580) [r, g, b] = [(nm - 510) / 70, 1, 0];
    else if (nm < 645) [r, g, b] = [1, -(nm - 645) / 65, 0];
    else [r, g, b] = [1, 0, 0];
    let k = 1;
    if (nm > 700) k = 0.3 + (0.7 * (780 - nm)) / 80;
    else if (nm < 420) k = 0.3 + (0.7 * (nm - 380)) / 40;
    k = Math.max(0.15, Math.min(1, k));
    return [r * 255 * k, g * 255 * k, b * 255 * k];
  }

  type Line = [number, number]; // [진동수(조 Hz), 세기 0~1]
  const thz = (nm: number) => 299792 / nm;
  const H: Line[] = [[thz(656.28), 1], [thz(486.13), 0.7], [thz(434.05), 0.45], [thz(410.17), 0.3]];
  const SRC: { name: string; lines: Line[]; note: string }[] = [
    { name: '백열전구', lines: [], note: '뜨거운 고체는 모든 진동수의 빛을 끊김 없이 내요. 이어진 띠가 보여요.' },
    { name: '수소', lines: H, note: '수소 기체의 빛: 눈에 보이는 선이 넷이에요.' },
    { name: '헬륨', lines: [[thz(706.5), 0.4], [thz(667.8), 0.6], [thz(587.56), 1], [thz(501.6), 0.45], [thz(492.2), 0.3], [thz(471.3), 0.35], [thz(447.1), 0.7]], note: '헬륨 기체의 빛: 노란 선이 가장 밝아요.' },
    { name: '나트륨', lines: [[thz(588.995), 1], [thz(589.592), 0.9], [thz(568.8), 0.15], [thz(615.4), 0.12]], note: '나트륨 기체의 빛: 거의 다 노란 선 두 개에 몰려 있어요.' },
    {
      name: '네온',
      lines: [585.25, 588.19, 594.48, 603.0, 607.43, 609.62, 614.31, 616.36, 621.73, 626.65, 633.44, 638.3, 640.22, 650.65, 659.9, 667.83, 692.95, 703.24, 540.06].map((nm, i) => [thz(nm), nm === 640.22 || nm === 585.25 ? 1 : nm === 540.06 ? 0.2 : 0.45 + 0.3 * ((i * 7) % 5) / 5] as Line),
      note: '네온 기체의 빛: 붉은빛과 주황빛 근처에 선이 아주 많아요.',
    },
    { name: '형광등(수은)', lines: [[thz(404.66), 0.5], [thz(435.83), 0.8], [thz(546.07), 1], [thz(576.96), 0.5], [thz(579.07), 0.5]], note: '형광등 속 수은의 빛: 보라, 파랑, 초록, 노랑에 밝은 선이 있어요.' },
    { name: '햇빛', lines: [[thz(656.28), 0.7], [thz(589.592), 0.8], [thz(588.995), 0.85], [thz(527.0), 0.5], [thz(518.36), 0.6], [thz(517.27), 0.55], [thz(486.13), 0.7], [thz(430.8), 0.6]], note: '햇빛: 이어진 무지개 띠 위에 검은 선이 있어요. 노란빛 근처의 두 선은 나트륨의 자리예요.' },
  ];

  const F0 = 380;

  class SimSpectrum extends Sim {
    animated = false;

    readout() {
      return SRC[this.p.s!]?.note ?? '';
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const src = SRC[this.p.s!] ?? SRC[0]!;
      const labels = this.dataset.labels === '1' && this.p.s === 1;
      const F1 = labels ? 850 : 800;
      const x0 = 16;
      const x1 = w - 16;
      const X = (f: number) => x0 + ((f - F0) / (F1 - F0)) * (x1 - x0);
      const top = labels ? h * 0.24 : h * 0.12;
      const bot = h * 0.66;
      // 띠
      const continuous = this.p.s === 0 || this.p.s === 6;
      if (continuous) {
        for (let px = Math.floor(X(400)); px < X(790); px++) {
          const f = F0 + ((px - x0) / (x1 - x0)) * (F1 - F0);
          const [r, gg, b] = rgb(f);
          g.fillStyle = `rgb(${r},${gg},${b})`;
          g.fillRect(px, top, 1, bot - top);
        }
        if (this.p.s === 6) {
          for (const [f, s] of src.lines) {
            g.fillStyle = `rgba(10,10,12,${0.55 + 0.45 * s})`;
            g.fillRect(X(f) - 1.2, top, 2.4, bot - top);
          }
        }
      } else {
        g.fillStyle = '#0b0b0d';
        g.fillRect(x0, top, x1 - x0, bot - top);
        for (const [f, s] of src.lines) {
          const [r, gg, b] = rgb(f);
          g.fillStyle = `rgba(${r},${gg},${b},${0.35 + 0.65 * s})`;
          g.fillRect(X(f) - 1.6, top, 3.2, bot - top);
        }
      }
      g.strokeStyle = c.line;
      g.strokeRect(x0, top, x1 - x0, bot - top);
      // 수소 선의 진동수와 한계
      if (labels) {
        H.forEach(([f], i) => {
          this.text(`${Math.round(f)}조`, X(f), top - 10 - (i % 2) * 12, c.text, 10, 'center');
        });
        const lim = 822.0;
        if (lim < F1) {
          g.setLineDash([3, 3]);
          this.line(X(lim), top - 4, X(lim), bot, c.muted, 1);
          g.setLineDash([]);
        }
        this.text('선들이 다가가는 끝 822조', X(822), top - 30, c.muted, 10, 'right');
      }
      // 가로축
      const ay = bot + 16;
      this.line(x0, ay, x1, ay, c.text2, 1);
      for (const t of [400, 500, 600, 700, 800]) {
        if (t > F1) continue;
        this.line(X(t), ay, X(t), ay + 4, c.text2, 1);
        this.text(`${t}조`, X(t), ay + 13, c.muted, 10, 'center');
      }
      this.text('진동수 (1초에 진동하는 횟수, Hz) →', (x0 + x1) / 2, h - 8, c.time, 11, 'center');
    }
  }
  define('qm-sim-spectrum', SimSpectrum);
</script>
