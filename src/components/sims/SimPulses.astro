---
/** 줄 양쪽에서 보낸 두 물결이 만난다. 같은 쪽으로 솟은 물결과 반대쪽으로 솟은 물결을 비교한다. */
interface Props {
  flip?: 0 | 1;
}
const { flip = 0 } = Astro.props;
---
<qm-sim-pulses class="sim" data-ratio="0.5">
  <canvas aria-label="줄 양쪽에서 출발한 두 물결이 가운데서 만났다가 지나가요. 점선은 각 물결이고, 실선은 둘을 더한 줄의 모양이에요"></canvas>
  <input type="hidden" data-param="flip" value={flip} />
  <div class="sim__buttons">
    <button type="button" class="btn" data-set="flip=0" aria-pressed={flip === 0 ? 'true' : 'false'}>둘 다 위로</button>
    <button type="button" class="btn" data-set="flip=1" aria-pressed={flip === 1 ? 'true' : 'false'}>하나는 아래로</button>
    <button type="button" class="btn" data-play>재생</button>
  </div>
  <p class="sim__readout"></p>
</qm-sim-pulses>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  const L = 10;
  const V = 1.6;
  const T = 6.25;

  class SimPulses extends Sim {
    changed() {
      this.t = 0;
    }

    tick() {
      if (this.t > T) this.t = 0;
    }

    a(x: number) {
      const c = 1 + V * this.t;
      return Math.exp(-((x - c) ** 2) / 0.35);
    }

    b(x: number) {
      const c = L - 1 - V * this.t;
      return (this.p.flip ? -1 : 1) * Math.exp(-((x - c) ** 2) / 0.35);
    }

    readout() {
      const mid = this.a(L / 2) + this.b(L / 2);
      return `가운데 지점의 변위: ${mid.toFixed(2)} (물결 하나의 높이를 1로 잡았을 때)`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const mid = h * 0.55;
      const amp = h * 0.25;
      const X = (x: number) => 14 + (x / L) * (w - 28);
      const path = (f: (x: number) => number, col: string, width: number, dash: number[]) => {
        g.strokeStyle = col;
        g.lineWidth = width;
        g.setLineDash(dash);
        g.beginPath();
        for (let i = 0; i <= 300; i++) {
          const x = (L * i) / 300;
          const px = X(x);
          const py = mid - amp * f(x);
          if (i) g.lineTo(px, py);
          else g.moveTo(px, py);
        }
        g.stroke();
        g.setLineDash([]);
      };
      this.line(X(0), mid, X(L), mid, c.line, 1);
      path((x) => this.a(x), c.time, 1.5, [5, 4]);
      path((x) => this.b(x), c.force, 1.5, [5, 4]);
      path((x) => this.a(x) + this.b(x), c.text, 2.5, []);
      this.text('점선: 각 물결 · 실선: 실제 줄 모양(둘을 더한 것)', w / 2, 14, c.muted, 11, 'center');
      g.setLineDash([2, 4]);
      this.line(X(L / 2), mid - amp * 2.1, X(L / 2), mid + amp * 1.2, c.muted, 1);
      g.setLineDash([]);
    }
  }
  define('qm-sim-pulses', SimPulses);
</script>
