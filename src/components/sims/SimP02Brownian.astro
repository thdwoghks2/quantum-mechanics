---
/**
 * 22강: 브라운 운동. 물에 뜬 큰 알갱이 하나가 보이지 않는 물 분자들에게 사방에서 부딪혀 제멋대로 흔들린다.
 * 분자를 숨기면 브라운이 현미경으로 본 모습, 보이면 그 까닭이다. 알갱이를 크게 하면 흔들림이 줄어든다.
 * 충돌은 탄성 충돌로 계산한다(운동량 보존, 7강).
 */
interface Props {
  show?: 0 | 1;
  size?: 1 | 2 | 3;
}
const { show = 0, size = 1 } = Astro.props;
---
<qm-sim-brownian class="sim" data-ratio="0.8">
  <canvas aria-label="물에 뜬 알갱이 하나가 제멋대로 흔들리며 지그재그 자국을 남긴다. 분자를 보이게 하면 작은 물 분자들이 사방에서 부딪히는 게 보인다."></canvas>
  <input type="hidden" data-param="show" value={show} />
  <input type="hidden" data-param="size" value={size} />
  <div class="sim__buttons">
    <button type="button" class="btn" data-set="show=0" aria-pressed={show === 0 ? 'true' : 'false'}>분자 숨기기</button>
    <button type="button" class="btn" data-set="show=1" aria-pressed={show === 1 ? 'true' : 'false'}>분자 보이기</button>
  </div>
  <div class="sim__buttons" aria-label="알갱이 크기">
    <button type="button" class="btn" data-set="size=1" aria-pressed={size === 1 ? 'true' : 'false'}>작은 알갱이</button>
    <button type="button" class="btn" data-set="size=3" aria-pressed={size === 3 ? 'true' : 'false'}>큰 알갱이</button>
    <button type="button" class="btn" data-play>재생</button>
    <button type="button" class="btn" data-reset>처음부터</button>
  </div>
  <p class="sim__readout"></p>
</qm-sim-brownian>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  const N = 240;
  const r = 0.007;
  const SPEED = 0.55;

  interface M {
    x: number;
    y: number;
    vx: number;
    vy: number;
  }

  class SimBrownian extends Sim {
    mols: M[] = [];
    big: M = { x: 0.5, y: 0.5, vx: 0, vy: 0 };
    trail: [number, number][] = [];
    hits: number[] = [];
    lastSize = 0;

    init() {
      this.reset();
    }

    R() {
      return this.p.size === 3 ? 0.1 : 0.035;
    }

    M() {
      const k = this.R() / 0.035;
      return 160 * k * k;
    }

    reset() {
      this.big = { x: 0.5, y: 0.5, vx: 0, vy: 0 };
      this.trail = [[0.5, 0.5]];
      this.hits = [];
      this.mols = [];
      for (let i = 0; i < N; i++) {
        let x = 0;
        let y = 0;
        do {
          x = 0.02 + Math.random() * 0.96;
          y = 0.02 + Math.random() * 0.96;
        } while (Math.hypot(x - 0.5, y - 0.5) < this.R() + r * 2);
        const a = Math.random() * Math.PI * 2;
        const s = SPEED * (0.5 + Math.random());
        this.mols.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s });
      }
      this.lastSize = this.p.size ?? 1;
    }

    changed(name: string) {
      if (name === 'set' && this.p.size !== this.lastSize) this.reset();
    }

    tick(dt: number) {
      const steps = 3;
      const h = dt / steps;
      const R = this.R();
      const Mb = this.M();
      const b = this.big;
      for (let k = 0; k < steps; k++) {
        for (const m of this.mols) {
          m.x += m.vx * h;
          m.y += m.vy * h;
          if (m.x < r) { m.x = r; m.vx = Math.abs(m.vx); }
          if (m.x > 1 - r) { m.x = 1 - r; m.vx = -Math.abs(m.vx); }
          if (m.y < r) { m.y = r; m.vy = Math.abs(m.vy); }
          if (m.y > 1 - r) { m.y = 1 - r; m.vy = -Math.abs(m.vy); }
          const dx = m.x - b.x;
          const dy = m.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < R + r && d > 0) {
            const nx = dx / d;
            const ny = dy / d;
            const u = (m.vx - b.vx) * nx + (m.vy - b.vy) * ny;
            if (u < 0) {
              const J = ((2 * Mb) / (1 + Mb)) * u;
              m.vx -= J * nx;
              m.vy -= J * ny;
              b.vx += (J / Mb) * nx;
              b.vy += (J / Mb) * ny;
              this.hits.push(this.t);
            }
            m.x = b.x + nx * (R + r);
            m.y = b.y + ny * (R + r);
          }
        }
        b.x += b.vx * h;
        b.y += b.vy * h;
        if (b.x < R) { b.x = R; b.vx = Math.abs(b.vx); }
        if (b.x > 1 - R) { b.x = 1 - R; b.vx = -Math.abs(b.vx); }
        if (b.y < R) { b.y = R; b.vy = Math.abs(b.vy); }
        if (b.y > 1 - R) { b.y = 1 - R; b.vy = -Math.abs(b.vy); }
      }
      const last = this.trail[this.trail.length - 1]!;
      if (Math.hypot(b.x - last[0], b.y - last[1]) > 0.003) this.trail.push([b.x, b.y]);
      if (this.trail.length > 1500) this.trail.shift();
      while (this.hits.length && this.hits[0]! < this.t - 1) this.hits.shift();
    }

    readout() {
      const d = Math.hypot(this.big.x - 0.5, this.big.y - 0.5);
      return `최근 1초 동안 알갱이에 부딪힌 분자 ${this.hits.length}번 · 출발점에서 떨어진 거리 ${(d * 100).toFixed(0)} (상자 폭 100)`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const S = Math.min(w, h) - 16;
      const ox = (w - S) / 2;
      const oy = (h - S) / 2;
      const X = (v: number) => ox + v * S;
      const Y = (v: number) => oy + v * S;
      g.strokeStyle = c.line;
      g.lineWidth = 1;
      g.strokeRect(ox, oy, S, S);
      if (this.p.show) for (const m of this.mols) this.dot(X(m.x), Y(m.y), 2, c.muted);
      g.strokeStyle = c.accent;
      g.globalAlpha = 0.7;
      g.lineWidth = 1.2;
      g.beginPath();
      this.trail.forEach(([x, y], i) => (i ? g.lineTo(X(x), Y(y)) : g.moveTo(X(x), Y(y))));
      g.stroke();
      g.globalAlpha = 1;
      this.dot(X(0.5), Y(0.5), 2.5, c.text2);
      g.fillStyle = c.energy;
      g.beginPath();
      g.arc(X(this.big.x), Y(this.big.y), this.R() * S, 0, Math.PI * 2);
      g.fill();
    }
  }
  define('qm-sim-brownian', SimBrownian);
</script>
