---
/**
 * 원자 속 전자를 오비탈 칸에 채운다. 칸(오비탈) 하나에는 스핀이 반대인 전자가 많아야 둘.
 * 에너지가 낮은 칸부터 채우고, 같은 모양의 칸이 여럿이면 하나씩 먼저 채운다(훈트 규칙).
 * 크로뮴(24)과 구리(29)는 실제로 측정된 예외를 따른다.
 */
interface Props {
  z?: number;
  max?: number;
}
const { z = 3, max = 18 } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<qm-sim-p09-fill class="sim" data-ratio="0.66">
  <canvas aria-label="에너지가 낮은 칸부터 위로 늘어선 오비탈 칸들에, 원소의 전자들이 위아래 화살표로 채워진다"></canvas>
  <div class="sim__controls">
    <div class="sim__row">
      <label for={`p9f-z-${uid}`}>전자 수</label>
      <input id={`p9f-z-${uid}`} type="range" min="1" max={max} step="1" value={z} data-param="z" />
      <output data-out="z"></output>
    </div>
  </div>
  <p class="sim__readout"></p>
</qm-sim-p09-fill>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  const NAMES = ['', '수소 H', '헬륨 He', '리튬 Li', '베릴륨 Be', '붕소 B', '탄소 C', '질소 N', '산소 O', '플루오린 F', '네온 Ne',
    '나트륨 Na', '마그네슘 Mg', '알루미늄 Al', '규소 Si', '인 P', '황 S', '염소 Cl', '아르곤 Ar', '칼륨 K', '칼슘 Ca',
    '스칸듐 Sc', '타이타늄 Ti', '바나듐 V', '크로뮴 Cr', '망가니즈 Mn', '철 Fe', '코발트 Co', '니켈 Ni', '구리 Cu', '아연 Zn',
    '갈륨 Ga', '저마늄 Ge', '비소 As', '셀레늄 Se', '브로민 Br', '크립톤 Kr'];
  // 채우는 순서: [이름, n, 칸 수, 그림에서의 높이 순서, 가로 자리]
  const SUB: [string, number, number, number, number][] = [
    ['1s', 1, 1, 0, 0], ['2s', 2, 1, 2, 0], ['2p', 2, 3, 2.7, 1], ['3s', 3, 1, 4, 0], ['3p', 3, 3, 4.7, 1],
    ['4s', 4, 1, 5.8, 0], ['3d', 3, 5, 6.3, 2], ['4p', 4, 3, 7, 1],
  ];
  const SUP = '⁰¹²³⁴⁵⁶⁷⁸⁹';

  function counts(z: number) {
    const out = SUB.map(() => 0);
    let left = z;
    for (let i = 0; i < SUB.length && left > 0; i++) {
      const cap = SUB[i]![2] * 2;
      out[i] = Math.min(cap, left);
      left -= out[i]!;
    }
    // 측정된 예외: 크로뮴 4s¹ 3d⁵, 구리 4s¹ 3d¹⁰
    if (z === 24 || z === 29) {
      out[5] = 1;
      out[6] = z === 24 ? 5 : 10;
    }
    return out;
  }

  class SimP09Fill extends Sim {
    animated = false;

    format(name: string) {
      return name === 'z' ? String(this.p.z) : '';
    }

    readout() {
      const z = this.p.z!;
      const c = counts(z);
      const cfg = SUB.map((s, i) => (c[i] ? `${s[0]}${String(c[i]).split('').map((d) => SUP[Number(d)]).join('')}` : '')).filter(Boolean).join(' ');
      let nmax = 0;
      SUB.forEach((s, i) => { if (c[i]) nmax = Math.max(nmax, s[1]); });
      let outer = 0;
      SUB.forEach((s, i) => { if (s[1] === nmax) outer += c[i]!; });
      return `${z}번 ${NAMES[z]} · ${cfg} · 가장 바깥 칸(n = ${nmax})의 전자 ${outer}개`;
    }

    draw() {
      const { w, h, c } = this;
      const z = this.p.z!;
      const cnt = counts(z);
      const box = Math.min(24, w / 16);
      const colX = [w * 0.08, w * 0.3, w * 0.58];
      const top = 14;
      const bot = h - 22;
      this.text('에너지 ↑', 4, top, c.energy, 10);
      const max = Number((this.querySelector('input[data-param="z"]') as HTMLInputElement | null)?.max ?? 36);
      let before = 0;
      const shown = SUB.map((s) => { const ok = before < max; before += s[2] * 2; return ok; });
      const rTop = Math.max(1, ...SUB.filter((_, i) => shown[i]).map((s) => s[3]));
      const rowY2 = (r: number) => bot - (r / rTop) * (bot - top);
      SUB.forEach((s, i) => {
        if (!shown[i]) return;
        const [name, , k, r, col] = s;
        const y = rowY2(r);
        const filled = cnt[i]!;
        for (let b = 0; b < k; b++) {
          const x = colX[col]! + b * (box + 4);
          this.ctx.strokeStyle = filled ? c.text2 : c.line;
          this.ctx.lineWidth = 1.2;
          this.ctx.strokeRect(x, y - box / 2, box, box);
          // 훈트 규칙: 먼저 칸마다 위 화살표 하나씩, 그다음 아래 화살표
          const up = filled > b ? 1 : 0;
          const down = filled - k > b ? 1 : 0;
          if (up) this.arrow(x + box * 0.33, y + box * 0.32, x + box * 0.33, y - box * 0.32, c.accent, 2);
          if (down) this.arrow(x + box * 0.67, y - box * 0.32, x + box * 0.67, y + box * 0.32, c.space, 2);
        }
        this.text(name, colX[col]! - 4, y, filled ? c.text : c.muted, 11, 'right');
      });
    }
  }
  define('qm-sim-p09-fill', SimP09Fill);
</script>
