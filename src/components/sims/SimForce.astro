---
/** 카트 밀기: 처음 2초 동안 힘을 주고 손을 뗀다. 힘·질량·마찰을 바꿔 가속도와 관성을 본다. */
interface Props {
  f?: number;
  m?: number;
  mu?: 0 | 1;
}
const { f = 40, m = 20, mu = 0 } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<qm-sim-force class="sim" data-ratio="0.62">
  <canvas aria-label="카트를 2초 동안 밀었다가 손을 떼는 시뮬레이션과 속도-시간 그래프"></canvas>
  <div class="sim__controls">
    <div class="sim__row">
      <label for={`fo-f-${uid}`}>미는 힘</label>
      <input id={`fo-f-${uid}`} type="range" min="0" max="100" step="10" value={f} data-param="f" />
      <output data-out="f"></output>
    </div>
    <div class="sim__row">
      <label for={`fo-m-${uid}`}>카트 질량</label>
      <input id={`fo-m-${uid}`} type="range" min="10" max="50" step="5" value={m} data-param="m" />
      <output data-out="m"></output>
    </div>
    <input type="hidden" data-param="mu" value={mu} />
    <div class="sim__buttons">
      <button type="button" class="btn" data-set="mu=0" aria-pressed={mu === 0 ? 'true' : 'false'}>마찰 없음 (얼음)</button>
      <button type="button" class="btn" data-set="mu=1" aria-pressed={mu === 1 ? 'true' : 'false'}>마찰 있음 (바닥)</button>
      <button type="button" class="btn" data-play>재생</button>
      <button type="button" class="btn" data-reset>처음부터</button>
    </div>
  </div>
  <p class="sim__readout"></p>
</qm-sim-force>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  const PUSH = 2;
  const T = 8;
  const MU = 0.15;
  const G = 9.8;

  class SimForce extends Sim {
    v = 0;
    x = 0;
    trail: [number, number][] = [];

    changed() {
      this.resetState();
    }

    reset() {
      this.resetState();
    }

    resetState() {
      this.t = 0;
      this.v = 0;
      this.x = 0;
      this.trail = [];
    }

    pushing() {
      return this.t < PUSH;
    }

    friction() {
      return this.p.mu ? MU * this.p.m! * G : 0;
    }

    accel() {
      const F = this.pushing() ? this.p.f! : 0;
      const fr = this.friction();
      if (this.v <= 1e-6) {
        // 멈춰 있을 때는 미는 힘이 마찰보다 커야 움직인다.
        return F > fr ? (F - fr) / this.p.m! : 0;
      }
      return (F - fr) / this.p.m!;
    }

    tick(dt: number) {
      if (this.t > T) this.resetState();
      const a = this.accel();
      this.v = Math.max(0, this.v + a * dt);
      this.x += this.v * dt;
      this.trail.push([this.t, this.v]);
    }

    format(name: string) {
      if (name === 'f') return `${this.p.f} N`;
      return `${this.p.m} kg`;
    }

    readout() {
      const a = this.pushing() ? this.accel() : this.accel();
      return `${this.pushing() ? '미는 중' : '손을 뗌'} · 가속도 ${a.toFixed(2)} m/s² · 속도 ${this.v.toFixed(2)} m/s`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const floorY = h * 0.32;
      // 바닥
      g.fillStyle = this.p.mu ? c.ink3 : 'rgba(132,172,216,0.10)';
      g.fillRect(0, floorY, w, 10);
      const off = (this.x * 40) % 50;
      for (let sx = -off; sx < w; sx += 50) this.line(sx, floorY + 18, sx + 20, floorY + 18, c.muted, 1.2);
      this.text(this.p.mu ? '바닥 (마찰 있음)' : '얼음 (마찰 거의 없음)', w - 10, floorY + 30, c.muted, 11, 'right');
      // 카트
      const cx = w * 0.38;
      const size = 22 + this.p.m! * 0.6;
      g.fillStyle = c.ink3;
      g.strokeStyle = c.force;
      g.lineWidth = 2;
      g.fillRect(cx - size, floorY - size * 1.1, size * 2, size * 1.1);
      g.strokeRect(cx - size, floorY - size * 1.1, size * 2, size * 1.1);
      this.text(`${this.p.m} kg`, cx, floorY - size * 0.55, c.text, 12, 'center');
      // 힘 화살표
      if (this.pushing() && this.p.f! > 0) {
        const len = Math.min(this.p.f! * 1.1, cx - size - 14); // 화살표가 왼쪽 끝을 넘지 않게
        this.arrow(cx - size - len - 6, floorY - size * 0.55, cx - size - 6, floorY - size * 0.55, c.force, 3);
        this.text(`미는 힘 ${this.p.f} N`, cx - size - len / 2 - 6, floorY - size * 0.55 - 14, c.force, 11, 'center');
      } else {
        this.text('손을 뗀 뒤', cx - size - 40, floorY - size * 0.55, c.muted, 11, 'center');
      }
      const fr = this.friction();
      if (fr > 0 && (this.v > 0.01 || this.pushing())) {
        this.arrow(cx + size * 0.2, floorY + 4, cx + size * 0.2 - fr * 1.1, floorY + 4, c.no, 2);
        this.text(`마찰 ${fr.toFixed(0)} N`, cx + size * 0.2 - fr * 0.55, floorY + 18, c.no, 10, 'center');
      }
      // 그래프
      const gx0 = 44;
      const gx1 = w - 12;
      const gy0 = h - 38; // 눈금 숫자 한 줄과 축 이름 한 줄이 겹치지 않게
      const gy1 = h * 0.5;
      const VMAX = 10;
      const X = (t: number) => gx0 + (t / T) * (gx1 - gx0);
      const Y = (v: number) => gy0 - (Math.min(v, VMAX) / VMAX) * (gy0 - gy1);
      g.fillStyle = 'rgba(226,151,178,0.08)';
      g.fillRect(X(0), gy1, X(PUSH) - X(0), gy0 - gy1);
      this.text('미는 동안', (X(0) + X(PUSH)) / 2, gy1 + 10, c.force, 10, 'center');
      for (let v = 0; v <= VMAX; v += 5) {
        this.line(gx0, Y(v), gx1, Y(v), c.line, 1);
        this.text(String(v), gx0 - 6, Y(v), c.muted, 10, 'right');
      }
      for (let t = 0; t <= T; t += 2) this.text(String(t), X(t), gy0 + 11, c.muted, 10, 'center');
      this.line(gx0, gy0, gx1, gy0, c.text2, 1.2);
      this.line(gx0, gy0, gx0, gy1, c.text2, 1.2);
      this.text('속도 (m/s)', gx0 + 4, gy1 - 8, c.motion, 11);
      this.text('시간 (s)', (gx0 + gx1) / 2, h - 8, c.time, 11, 'center');
      g.strokeStyle = c.motion;
      g.lineWidth = 2.5;
      g.beginPath();
      this.trail.forEach(([t, v], i) => (i ? g.lineTo(X(t), Y(v)) : g.moveTo(X(t), Y(v))));
      g.stroke();
    }
  }
  define('qm-sim-force', SimForce);
</script>
