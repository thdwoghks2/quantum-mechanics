---
/**
 * 39강: 알파 입자를 원자 하나에 쏜다.
 * 톰슨의 원자(+ 전하가 원자 전체에 고르게 퍼짐)와 러더퍼드의 원자(+ 전하가 가운데 작은 점에 모임)를 비교한다.
 * 쿨롱 힘으로 길을 직접 계산한다. 퍼진 전하는 세게 밀지 못하고, 모인 전하는 가까이 온 입자를 되튕긴다.
 */
interface Props {
  /** 0: 톰슨의 원자, 1: 러더퍼드의 원자 */
  mode?: number;
}
const { mode = 0 } = Astro.props;
---
<qm-sim-scatter class="sim" data-ratio="0.66">
  <canvas aria-label="왼쪽에서 날아온 알파 입자들이 원자 하나를 지나간다. 톰슨의 원자에서는 모두 거의 곧게 지나가고, 러더퍼드의 원자에서는 가운데 가까이 온 몇 개가 크게 휘거나 되튕긴다."></canvas>
  <div class="sim__buttons" aria-label="원자 고르기">
    <button type="button" class="btn" data-set="m=0" aria-pressed={mode === 0 ? 'true' : 'false'}>톰슨의 원자</button>
    <button type="button" class="btn" data-set="m=1" aria-pressed={mode === 1 ? 'true' : 'false'}>러더퍼드의 원자</button>
    <button type="button" class="btn" data-play>재생</button>
  </div>
  <input type="hidden" data-param="m" value={mode} />
  <p class="sim__readout"></p>
</qm-sim-scatter>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  // 길이 단위: 원자의 반지름 = 1. 입자의 처음 빠르기 = 1.
  const D0 = 0.06; // 정면으로 올 때 가장 가까이 가는 거리 (러더퍼드의 원자)
  const K = D0 / 2; // 밀어내는 힘의 세기 (가속도 = K / r²)
  const START = -2.4;
  const END = 2.6;

  type P = { x: number; y: number; vx: number; vy: number; trail: [number, number][] };

  function accel(m: number, x: number, y: number): [number, number] {
    const r = Math.hypot(x, y);
    if (r < 1e-6) return [0, 0];
    // 러더퍼드: 점 전하. 톰슨: 반지름 1인 공에 고르게 퍼진 전하(안에서는 힘이 r에 비례).
    const a = m === 1 ? K / (r * r) : r >= 1 ? K / (r * r) : K * r;
    return [(a * x) / r, (a * y) / r];
  }

  function step(m: number, p: P, dt: number) {
    const [ax, ay] = accel(m, p.x, p.y);
    p.vx += ax * dt;
    p.vy += ay * dt;
    p.x += p.vx * dt;
    p.y += p.vy * dt;
  }

  function path(m: number, b: number): [number, number][] {
    const p: P = { x: START, y: b, vx: 1, vy: 0, trail: [] };
    const out: [number, number][] = [[p.x, p.y]];
    for (let i = 0; i < 20000; i++) {
      step(m, p, 0.002);
      if (i % 6 === 0) out.push([p.x, p.y]);
      if (p.x > END || p.x < START - 0.1 || Math.abs(p.y) > 1.6) break;
    }
    out.push([p.x, p.y]);
    return out;
  }

  const BS = [-0.85, -0.55, -0.3, -0.14, -0.05, -0.02, -0.006, 0.006, 0.02, 0.05, 0.14, 0.3, 0.55, 0.85];

  class SimScatter extends Sim {
    parts: P[] = [];
    fired = 0;
    back = 0;
    spawn = 0;
    cache = new Map<number, [number, number][][]>();

    changed() {
      this.parts = [];
      this.fired = 0;
      this.back = 0;
    }

    paths() {
      const m = this.p.m!;
      if (!this.cache.has(m)) this.cache.set(m, BS.map((b) => path(m, b)));
      return this.cache.get(m)!;
    }

    tick(dt: number) {
      const m = this.p.m!;
      this.spawn -= dt;
      if (this.spawn <= 0) {
        this.spawn = 0.12;
        // 가운데 가까이 오는 입자가 조금 더 자주 보이게, 원자 안쪽 높이에서 고르게 고른다.
        const b = (Math.random() * 2 - 1) * 1.05;
        this.parts.push({ x: START, y: b, vx: 1, vy: 0, trail: [] });
        this.fired++;
      }
      const sub = Math.ceil((dt * 1.6) / 0.002);
      for (const p of this.parts) {
        for (let i = 0; i < sub; i++) step(m, p, (dt * 1.6) / sub);
        p.trail.push([p.x, p.y]);
        if (p.trail.length > 40) p.trail.shift();
      }
      const keep: P[] = [];
      for (const p of this.parts) {
        const out = p.x > END || p.x < START - 0.1 || Math.abs(p.y) > 1.6;
        if (out) {
          if (p.vx < 0) this.back++;
        } else keep.push(p);
      }
      this.parts = keep;
    }

    readout() {
      const m = this.p.m!;
      const head = m === 1 ? '러더퍼드의 원자: + 전하가 가운데 작은 점에 모여 있어요.' : '톰슨의 원자: + 전하가 원자 전체에 고르게 퍼져 있어요.';
      if (!this.fired) return head;
      return `${head} 쏜 알파 입자 ${this.fired}개 가운데 되튕긴 것 ${this.back}개.`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const m = this.p.m!;
      const R = h * 0.36;
      const cx = w * 0.48;
      const cy = h * 0.5;
      const X = (x: number) => cx + x * R;
      const Y = (y: number) => cy - y * R;
      // 원자
      if (m === 0) {
        g.fillStyle = 'rgba(214, 140, 120, 0.16)';
        g.beginPath();
        g.arc(cx, cy, R, 0, Math.PI * 2);
        g.fill();
        this.text('+ 전하가 고르게 퍼진 공', cx, cy - R - 10, c.muted, 10, 'center');
      } else {
        g.strokeStyle = c.line;
        g.setLineDash([3, 5]);
        g.beginPath();
        g.arc(cx, cy, R, 0, Math.PI * 2);
        g.stroke();
        g.setLineDash([]);
        this.dot(cx, cy, 3, c.accent);
        this.text('+ 전하가 모인 작은 점', cx, cy - R - 10, c.muted, 10, 'center');
      }
      for (let k = 0; k < 8; k++) {
        const a = (k / 8) * Math.PI * 2 + 0.4;
        const r = R * (0.45 + 0.4 * ((k * 37) % 10) / 10);
        this.dot(cx + r * Math.cos(a), cy + r * Math.sin(a), 2.2, c.charge);
      }
      // 미리 계산한 길 (흐리게)
      g.lineWidth = 1.2;
      g.strokeStyle = 'rgba(220, 200, 140, 0.35)';
      for (const pts of this.paths()) {
        g.beginPath();
        pts.forEach(([x, y], i) => (i ? g.lineTo(X(x), Y(y)) : g.moveTo(X(x), Y(y))));
        g.stroke();
      }
      // 날아가는 입자
      for (const p of this.parts) {
        g.strokeStyle = 'rgba(240, 200, 110, 0.7)';
        g.lineWidth = 1.6;
        g.beginPath();
        p.trail.forEach(([x, y], i) => (i ? g.lineTo(X(x), Y(y)) : g.moveTo(X(x), Y(y))));
        g.stroke();
        this.dot(X(p.x), Y(p.y), 3, c.energy);
      }
      this.text('알파 입자 →', 8, 14, c.energy, 11);
      this.text('작은 점: 전자', w - 8, h - 10, c.charge, 10, 'right');
    }
  }
  define('qm-sim-scatter', SimScatter);
</script>
