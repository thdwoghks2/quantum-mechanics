---
/**
 * 37강: 음극선이 전기를 띤 두 판 사이를 지나며 휜다.
 * 판의 전압(세기와 +/− 방향)을 바꾸고, 줄기를 이루는 알갱이를 바꿔 본다.
 * 같은 전기력을 받아도 질량에 대한 전하의 비가 작으면 거의 휘지 않는다.
 */
interface Props {
  /** 처음 판의 세기 (−3 ~ 3, +면 윗판이 +) */
  v?: number;
  /** 알갱이 고르기 버튼을 보일지 */
  particles?: boolean;
}
const { v = 0, particles = false } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<qm-sim-cathode class="sim" data-ratio="0.56">
  <canvas aria-label="유리관 왼쪽 음극에서 나온 줄기가 위아래 두 판 사이를 지나 화면에 닿는다. 판에 전기를 걸면 줄기가 + 판으로 휜다."></canvas>
  <div class="sim__controls">
    <div class="sim__row">
      <label for={`cr-v-${uid}`}>판에 건 전기</label>
      <input id={`cr-v-${uid}`} type="range" min="-3" max="3" step="1" value={v} data-param="v" />
      <output data-out="v"></output>
    </div>
    {particles ? (
      <div class="sim__buttons" aria-label="줄기를 이루는 알갱이">
        <button type="button" class="btn" data-set="k=1" aria-pressed="true">음극선</button>
        <button type="button" class="btn" data-set="k=0.000545" aria-pressed="false">1,836배 무거운 알갱이</button>
        <button type="button" class="btn" data-play>재생</button>
      </div>
    ) : (
      <div class="sim__buttons">
        <input type="hidden" data-param="k" value="1" />
        <button type="button" class="btn" data-play>재생</button>
      </div>
    )}
  </div>
  <p class="sim__readout"></p>
</qm-sim-cathode>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  class SimCathode extends Sim {
    init() {
      if (this.p.k === undefined) this.p.k = 1;
    }

    format(name: string) {
      const v = this.p.v!;
      if (name === 'v') return v === 0 ? '없음' : `${v > 0 ? '윗판' : '아랫판'} + ${Math.abs(v)}`;
      return '';
    }

    /** 판을 지나고 화면에 닿을 때의 휘어진 높이 (판 사이 간격에 대한 비, 위가 +) */
    bend() {
      // 음극선은 − 전하라서 + 판으로 끌린다: 윗판이 +(v>0)이면 위로 휜다.
      return 0.11 * this.p.v! * this.p.k!;
    }

    readout() {
      const v = this.p.v!;
      if (v === 0) return '판에 전기를 걸지 않으면 줄기는 곧게 가요.';
      const up = v > 0;
      if (this.p.k! < 0.01) return `${up ? '윗판' : '아랫판'}이 +예요. 같은 전기력을 받아도 1,836배 무거운 알갱이는 거의 휘지 않아요.`;
      return `${up ? '윗판' : '아랫판'}이 +예요. 줄기가 + 판으로 휘니까, 줄기는 − 전하를 띠고 있어요.`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const mid = h * 0.5;
      const x0 = 34; // 음극
      const p0 = w * 0.34; // 판 시작
      const p1 = w * 0.58; // 판 끝
      const sx = w - 26; // 화면
      const gap = h * 0.17; // 판과 가운데 사이
      const v = this.p.v!;
      // 유리관
      g.strokeStyle = c.line;
      g.lineWidth = 1.5;
      g.beginPath();
      const neck = h * 0.27;
      g.moveTo(16, mid - neck);
      g.lineTo(p1 + 22, mid - neck);
      g.lineTo(sx - 24, mid - h * 0.44);
      g.lineTo(sx + 8, mid - h * 0.44);
      g.lineTo(sx + 8, mid + h * 0.44);
      g.lineTo(sx - 24, mid + h * 0.44);
      g.lineTo(p1 + 22, mid + neck);
      g.lineTo(16, mid + neck);
      g.closePath();
      g.stroke();
      // 음극과 양극
      this.line(x0, mid - 16, x0, mid + 16, c.text2, 4);
      this.text('음극 −', x0, mid + 30, c.muted, 10, 'center');
      this.line(x0 + 40, mid - 16, x0 + 40, mid - 4, c.text2, 4);
      this.line(x0 + 40, mid + 4, x0 + 40, mid + 16, c.text2, 4);
      this.text('양극 +', x0 + 40, mid - 30, c.muted, 10, 'center');
      // 두 판
      const topSign = v > 0 ? '+' : v < 0 ? '−' : '';
      const botSign = v > 0 ? '−' : v < 0 ? '+' : '';
      const topCol = v === 0 ? c.text2 : c.charge;
      this.line(p0, mid - gap, p1, mid - gap, topCol, 4);
      this.line(p0, mid + gap, p1, mid + gap, topCol, 4);
      if (topSign) {
        this.text(topSign, p1 + 10, mid - gap, c.charge, 15, 'center');
        this.text(botSign, p1 + 10, mid + gap, c.charge, 15, 'center');
      }
      this.text('전기를 거는 두 판', (p0 + p1) / 2, mid + gap + 16, c.muted, 10, 'center');
      // 화면
      this.line(sx, mid - h * 0.4, sx, mid + h * 0.4, c.text2, 3);
      this.text('화면', sx - 4, h - 10, c.muted, 10, 'right');
      // 줄기의 길: 판 사이에서는 포물선, 판을 지나면 곧은 선
      const b = this.bend(); // 판 끝에서의 휨 (판 간격 비)
      const yEnd = b * gap; // 판 끝에서의 휨(px)
      const slope = (2 * yEnd) / (p1 - p0); // 판 끝에서의 기울기
      const yAt = (x: number) => {
        if (x <= p0) return 0;
        if (x <= p1) {
          const u = (x - p0) / (p1 - p0);
          return yEnd * u * u;
        }
        return yEnd + slope * (x - p1);
      };
      const clampY = (y: number) => Math.max(-h * 0.38, Math.min(h * 0.38, y));
      g.strokeStyle = 'rgba(126, 200, 160, 0.55)';
      g.lineWidth = 3;
      g.beginPath();
      for (let x = x0 + 4; x <= sx; x += 3) {
        const y = mid - clampY(yAt(x));
        if (x === x0 + 4) g.moveTo(x, y);
        else g.lineTo(x, y);
      }
      g.stroke();
      // 화면의 빛나는 점
      const hit = mid - clampY(yAt(sx));
      this.dot(sx, hit, 7, 'rgba(126, 200, 160, 0.35)');
      this.dot(sx, hit, 3.5, '#7ec8a0');
      // 흐르는 알갱이 (재생 중일 때)
      if (this.playing) {
        for (let i = 0; i < 7; i++) {
          const u = (this.t * 0.6 + i / 7) % 1;
          const x = x0 + 4 + u * (sx - x0 - 4);
          this.dot(x, mid - clampY(yAt(x)), 2.4, c.charge);
        }
      }
    }
  }
  define('qm-sim-cathode', SimCathode);
</script>
