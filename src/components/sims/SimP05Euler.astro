---
/**
 * 54강: 오일러 공식으로 가는 두 그림.
 * mode="interest": 1년 이자율 100 %를 n번으로 쪼개 붙이면 1년 뒤 (1 + 1/n)ⁿ배. n이 커지면 e ≈ 2.718에 다가간다.
 * mode="steps": 1에 (1 + iθ/n)을 n번 곱한 점들. n이 커지면 반지름 1인 원 위, 편각 θ인 점 e^{iθ}에 다가간다.
 */
interface Props {
  mode?: 'interest' | 'steps';
}
const { mode = 'interest' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<qm-sim-euler class="sim" data-ratio={mode === 'interest' ? '0.6' : '0.8'} data-mode={mode}>
  <canvas aria-label={mode === 'interest' ? '1년 동안 돈이 불어나는 계단 그래프. 이자를 잘게 쪼개 붙일수록 1년 뒤의 돈이 2.718배에 다가간다.' : '복소평면에서 1에 (1 + iθ/n)을 거듭 곱한 점들이 반지름 1인 원을 따라 늘어선다. n이 커질수록 점들이 원에 붙는다.'}></canvas>
  <div class="sim__controls">
    {mode === 'interest' ? (
      <>
        <input type="hidden" data-param="n" value="1" />
        <div class="sim__buttons" aria-label="1년에 이자를 붙이는 횟수">
          {[1, 2, 4, 12, 52, 365].map((k) => (
            <button type="button" class="btn" data-set={`n=${k}`} aria-pressed={k === 1 ? 'true' : 'false'}>{k === 1 ? '1년에 한 번' : k === 2 ? '반년마다' : k === 4 ? '석 달마다' : k === 12 ? '달마다' : k === 52 ? '주마다' : '날마다'}</button>
          ))}
        </div>
      </>
    ) : (
      <>
        <div class="sim__row">
          <label for={`eu-n-${uid}`}>쪼갠 횟수 n</label>
          <input id={`eu-n-${uid}`} type="range" min="1" max="60" step="1" value="4" data-param="n" />
          <output data-out="n"></output>
        </div>
        <div class="sim__row">
          <label for={`eu-t-${uid}`}>돌릴 각도 θ</label>
          <input id={`eu-t-${uid}`} type="range" min="0" max="6.28" step="0.01" value="3.14" data-param="t" />
          <output data-out="t"></output>
        </div>
      </>
    )}
  </div>
  <p class="sim__readout"></p>
</qm-sim-euler>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';

  class SimEuler extends Sim {
    animated = false;

    format(name: string) {
      if (name === 't') return `${this.p.t!.toFixed(2)} (${Math.round((this.p.t! * 180) / Math.PI)}°)`;
      return `${this.p.n}번`;
    }

    pts(): [number, number][] {
      const n = this.p.n!;
      const t = this.p.t!;
      const out: [number, number][] = [[1, 0]];
      let re = 1;
      let im = 0;
      for (let k = 0; k < n; k++) {
        // (re + i im) × (1 + i t/n)
        const nr = re - (im * t) / n;
        const ni = im + (re * t) / n;
        re = nr;
        im = ni;
        out.push([re, im]);
      }
      return out;
    }

    readout() {
      if (this.dataset.mode === 'interest') {
        const n = this.p.n!;
        const v = (1 + 1 / n) ** n;
        return `1년에 ${n}번, 한 번에 ${(100 / n).toFixed(n > 12 ? 2 : 1)} %씩 → 1년 뒤 (1 + 1/${n})^${n} ≈ ${v.toFixed(4)}배 (e ≈ 2.7183)`;
      }
      const p = this.pts().at(-1)!;
      const len = Math.hypot(p[0], p[1]);
      const ang = Math.atan2(p[1], p[0]);
      return `(1 + i·${this.p.t!.toFixed(2)}/${this.p.n})을 ${this.p.n}번 곱한 끝점: 길이 ${len.toFixed(3)}, 편각 ${(((ang * 180) / Math.PI + 360) % 360).toFixed(0)}° · 목표 e^(iθ): 길이 1, 편각 ${Math.round((this.p.t! * 180) / Math.PI)}°`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      if (this.dataset.mode === 'interest') {
        const n = this.p.n!;
        const x0 = 44;
        const x1 = w - 12;
        const y0 = h - 26;
        const y1 = 14;
        const X = (t: number) => x0 + t * (x1 - x0);
        const Y = (v: number) => y0 - ((v - 0.8) / (3 - 0.8)) * (y0 - y1);
        this.line(x0, y0, x1, y0, c.text2, 1);
        this.line(x0, y0, x0, y1, c.text2, 1);
        for (const v of [1, 2, 2.718]) {
          g.setLineDash([3, 4]);
          this.line(x0, Y(v), x1, Y(v), v === 2.718 ? c.accent : c.line, 1);
          g.setLineDash([]);
          this.text(v === 2.718 ? 'e' : `${v}`, x0 - 6, Y(v), v === 2.718 ? c.accent : c.muted, 10, 'right');
        }
        this.text('1년 →', x1, y0 + 14, c.time, 10, 'right');
        this.text('처음 돈의 몇 배', x0 + 4, y1 + 2, c.energy, 10);
        // 계단
        g.strokeStyle = c.energy;
        g.lineWidth = 2.5;
        g.beginPath();
        let v = 1;
        g.moveTo(X(0), Y(v));
        for (let k = 1; k <= n; k++) {
          g.lineTo(X(k / n), Y(v));
          v *= 1 + 1 / n;
          g.lineTo(X(k / n), Y(v));
        }
        g.stroke();
        this.dot(X(1), Y(v), 4, c.energy);
        this.text(`${v.toFixed(3)}배`, X(1) - 6, Y(v) - 12, c.energy, 11, 'right');
        return;
      }
      const cx = w / 2;
      const cy = h / 2;
      // 적게 쪼개면 거듭 곱한 점이 원 밖으로 멀리 나간다. 가장 먼 점까지 들어가게 축척을 줄인다.
      const far = Math.max(1.3, ...this.pts().map(([x, y]) => Math.hypot(x, y) * 1.08));
      const S = (Math.min(w, h) * 0.32 * 1.3) / far;
      const X = (x: number) => cx + x * S;
      const Y = (y: number) => cy - y * S;
      const ax = Math.max(1.45, far * 0.98); // 축은 가장 먼 점까지 닿게
      this.line(X(-ax), cy, X(ax), cy, c.text2, 1);
      this.line(cx, Y(-ax), cx, Y(ax), c.text2, 1);
      this.text('실수 축', X(ax), cy - 10, c.muted, 10, 'right');
      this.text('허수 축', cx + 6, Y(ax * 0.97), c.muted, 10);
      g.strokeStyle = c.line;
      g.setLineDash([3, 4]);
      g.beginPath();
      g.arc(cx, cy, S, 0, Math.PI * 2);
      g.stroke();
      g.setLineDash([]);
      this.text('반지름 1인 원', X(0.72), Y(-0.8), c.muted, 10);
      const t = this.p.t!;
      // 목표 e^{iθ}
      this.dot(X(Math.cos(t)), Y(Math.sin(t)), 6, c.accent);
      this.text('e^(iθ)', X(Math.cos(t)) + 8, Y(Math.sin(t)) - 10, c.accent, 11);
      // 거듭 곱한 점들
      const pts = this.pts();
      g.strokeStyle = c.time;
      g.lineWidth = 2;
      g.beginPath();
      pts.forEach(([x, y], i) => (i ? g.lineTo(X(x), Y(y)) : g.moveTo(X(x), Y(y))));
      g.stroke();
      for (const [x, y] of pts) this.dot(X(x), Y(y), 2.5, c.time);
      this.dot(X(1), Y(0), 4, c.text);
      this.text('1에서 출발', X(1) + 6, Y(0) + 12, c.text2, 10);
    }
  }
  define('qm-sim-euler', SimEuler);
</script>
