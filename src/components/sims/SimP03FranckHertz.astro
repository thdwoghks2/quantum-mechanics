---
/**
 * 46강: 프랑크-헤르츠 실험. 수은 기체가 든 관에서 전자를 전압으로 가속하고, 끝의 판에 닿는 전류를 잰다.
 * 전압이 4.9 V를 넘을 때마다 전류가 뚝 떨어진다. 전자가 수은 원자에 꼭 4.9 V만큼의 에너지를 넘겨주기 때문이다.
 * 그래프는 지금까지 올린 전압까지만 그린다(재는 사람이 눈금을 올려 가며 기록하는 것처럼).
 */
const uid = Math.random().toString(36).slice(2, 8);
---
<qm-sim-franck class="sim" data-ratio="0.78">
  <canvas aria-label="위에는 달군 음극, 전압을 거는 그물, 전류를 재는 판이 있는 관이 그려져 있고, 아래에는 가속 전압에 따른 전류 그래프가 그려진다. 전류는 4.9 V, 9.8 V, 14.7 V를 넘을 때마다 뚝 떨어진다."></canvas>
  <div class="sim__controls">
    <div class="sim__row">
      <label for={`fh-v-${uid}`}>가속 전압</label>
      <input id={`fh-v-${uid}`} type="range" min="0" max="15" step="0.1" value="0" data-param="v" />
      <output data-out="v"></output>
    </div>
    <div class="sim__buttons">
      <button type="button" class="btn" data-play>재생</button>
      <button type="button" class="btn" data-reset>그래프 지우기</button>
    </div>
  </div>
  <p class="sim__readout"></p>
</qm-sim-franck>

<script>
  import { Sim, define } from '../../lib/client/sim.ts';
  import { prefersReducedMotion } from '../../lib/client/bus.ts';

  const STEP = 4.9; // 수은 원자가 받는 에너지 덩어리 (V)

  /** 판에 닿는 전류 (임의 단위) */
  function current(v: number) {
    if (v <= 0) return 0;
    const k = Math.floor(v / STEP);
    const u = v - k * STEP;
    // 4.9 V를 넘는 순간 전자들이 에너지를 넘겨주고 판에 못 닿아 전류가 떨어진다.
    const base = 0.12 + 0.88 * Math.pow(u / STEP, 1.4);
    return (0.55 + 0.32 * k) * base * Math.min(1, v / 1.2);
  }

  class SimFranck extends Sim {
    maxV = 0;
    animated = true;

    init() {
      // 움직임을 줄이는 설정이면 그래프 전체를 처음부터 보여 준다.
      if (prefersReducedMotion()) this.maxV = 15;
    }

    reset() {
      this.maxV = this.p.v!;
    }

    changed() {
      this.maxV = Math.max(this.maxV, this.p.v!);
    }

    tick(dt: number) {
      // 재생하면 전압을 천천히 올린다.
      let v = this.p.v! + dt * 1.6;
      if (v > 15) v = 0;
      this.p.v = Math.round(v * 10) / 10;
      const input = this.querySelector<HTMLInputElement>('input[data-param="v"]');
      if (input) input.value = String(this.p.v);
      if (this.p.v < 0.2) this.maxV = 0;
      this.maxV = Math.max(this.maxV, this.p.v);
      this.renderOutputs();
    }

    format() {
      return `${this.p.v!.toFixed(1)} V`;
    }

    readout() {
      const v = this.p.v!;
      const k = Math.floor(v / STEP);
      if (k === 0) return `전자가 얻는 에너지가 4.9 V어치보다 작아요. 수은 원자와 부딪혀도 튕기기만 하고 에너지를 거의 잃지 않아요.`;
      return `전자가 수은 원자에 4.9 V어치의 에너지를 ${k}번까지 넘겨줄 수 있어요. 그만큼 원자가 들뜨고, 내려오며 자외선을 내요.`;
    }

    draw() {
      const { w, h, c } = this;
      const g = this.ctx;
      const v = this.p.v!;
      // 위: 관
      const ty = h * 0.18;
      const x0 = 30;
      const xg = w * 0.78;
      const x1 = w - 24;
      g.strokeStyle = c.line;
      g.lineWidth = 1.2;
      g.strokeRect(12, ty - 26, w - 24, 52);
      this.line(x0, ty - 16, x0, ty + 16, c.heat, 4);
      this.text('달군 음극', x0, ty + 32, c.muted, 10, 'center');
      g.setLineDash([2, 3]);
      this.line(xg, ty - 18, xg, ty + 18, c.text2, 2);
      g.setLineDash([]);
      this.text('그물', xg, ty + 32, c.muted, 10, 'center');
      this.line(x1, ty - 16, x1, ty + 16, c.charge, 4);
      this.text('판', x1, ty + 32, c.muted, 10, 'center');
      this.text('수은 기체', (x0 + xg) / 2, ty - 34, c.muted, 10, 'center');
      // 수은 원자가 들뜨는 자리 (전자가 4.9 V어치를 얻는 곳마다)
      const k = Math.floor(v / STEP);
      for (let i = 1; i <= k; i++) {
        const x = x0 + ((i * STEP) / v) * (xg - x0);
        g.fillStyle = 'rgba(150, 120, 230, 0.28)';
        g.fillRect(x - 6, ty - 22, 16, 44);
      }
      if (k > 0) this.text('자외선이 나오는 곳', x0 + ((STEP / v) * (xg - x0)), ty - 34 + 0, 'rgb(170,150,240)', 9, 'center');
      // 날아가는 전자
      if (this.playing || v > 0) {
        for (let i = 0; i < 6; i++) {
          const u = (this.t * 0.5 + i / 6) % 1;
          const x = x0 + u * (x1 - x0);
          const yy = ty + ((i * 13) % 20) - 10;
          this.dot(x, yy, 2.2, c.charge);
        }
      }
      // 아래: 그래프
      const gx0 = 44;
      const gx1 = w - 14;
      const gy0 = h - 30;
      const gy1 = h * 0.42;
      const X = (vv: number) => gx0 + (vv / 15) * (gx1 - gx0);
      const Y = (ii: number) => gy0 - (ii / 1.6) * (gy0 - gy1);
      this.line(gx0, gy0, gx1, gy0, c.text2, 1);
      this.line(gx0, gy0, gx0, gy1, c.text2, 1);
      for (const t of [0, 4.9, 9.8, 14.7]) {
        this.line(X(t), gy0, X(t), gy0 + 4, c.text2, 1);
        this.text(`${t}`, X(t), gy0 + 13, c.muted, 10, 'center');
      }
      this.text('가속 전압 (V) →', (gx0 + gx1) / 2, h - 6, c.energy, 10, 'center');
      g.save();
      g.translate(14, (gy0 + gy1) / 2);
      g.rotate(-Math.PI / 2);
      this.text('판에 닿는 전류 →', 0, 0, c.charge, 10, 'center');
      g.restore();
      g.strokeStyle = c.charge;
      g.lineWidth = 2;
      g.beginPath();
      const end = Math.max(this.maxV, v);
      for (let vv = 0; vv <= end + 1e-9; vv += 0.05) {
        const x = X(vv);
        const y = Y(current(vv));
        if (vv === 0) g.moveTo(x, y);
        else g.lineTo(x, y);
      }
      g.stroke();
      this.dot(X(v), Y(current(v)), 4, c.accent);
    }
  }
  define('qm-sim-franck', SimFranck);
</script>
