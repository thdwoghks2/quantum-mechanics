---
/**
 * 정의 카드. 용어집(glossary.yaml)의 항목을 그대로 보여준다.
 * 정의는 한 곳(용어집)에만 쓰고, 레슨과 용어집 페이지가 같은 내용을 쓴다.
 */
import { getEntry } from 'astro:content';

interface Props {
  term: string;
}
const { term } = Astro.props;
const entry = await getEntry('glossary', term);
if (!entry) throw new Error(`용어집에 없는 용어: ${term}`);
const d = entry.data;
---
<article class="defcard" data-q={d.q} data-term={term}>
  <p class="defcard__kicker label">정의</p>
  <h3 class="defcard__term">{d.term}</h3>
  <p class="defcard__def">{d.definition}</p>
  {d.unit && <p class="defcard__unit"><span class="label">단위</span> <span class="mono">{d.unit}</span></p>}
  <div class="defcard__ex">
    <p class="label">예</p>
    <ul>
      {d.examples.map((e) => <li>{e}</li>)}
    </ul>
  </div>
  {d.notThis && (
    <div class="defcard__not">
      <p class="label">헷갈림 주의</p>
      <p>{d.notThis}</p>
    </div>
  )}
</article>

<style>
  .defcard {
    width: 100%;
    max-width: 480px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--ink-3), var(--ink-2));
    padding: 18px 18px 16px;
    display: grid;
    gap: 10px;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .defcard__kicker {
    letter-spacing: 0.12em;
  }

  /* 용어를 크게, 그 물리량의 색으로 밑줄 하나 */
  .defcard__term {
    justify-self: start;
    font-size: clamp(1.9rem, 8.5vw, 2.4rem);
    line-height: 1.15;
    color: var(--text);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--qc, var(--q-plain));
  }

  .defcard__def {
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text);
  }

  .defcard__unit {
    color: var(--text-2);
  }

  .defcard ul {
    margin: 2px 0 0;
    padding-left: 1.1em;
    color: var(--text-2);
    display: grid;
    gap: 2px;
  }

  .defcard__ex,
  .defcard__not {
    display: grid;
    gap: 2px;
  }

  .defcard__not p:last-child {
    color: var(--text-2);
  }
</style>
