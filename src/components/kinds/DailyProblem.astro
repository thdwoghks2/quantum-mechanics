---
/**
 * 마지막 점검. 문제(본문), 힌트 한두 개(hint1~hint3 가운데 쓴 것만), 풀이(solution).
 * 힌트는 하나씩 열리고, 메모는 이 기기에 저장된다. 계산보다 생각을 묻는 짧은 문제 하나가 좋다.
 */
interface Props {
  id: string;
}
const { id } = Astro.props;
const noteId = `note-${id}`;
const hints = [1, 2, 3].filter((i) => Astro.slots.has(`hint${i}`));
---
<qm-problem class="problem" data-id={id} data-hints={hints.length}>
  <div class="problem__q"><slot /></div>
  <label class="label" for={noteId}>메모 (이 기기에 저장돼요)</label>
  <textarea id={noteId} class="problem__note" rows="3" placeholder="생각한 걸 적어 보세요"></textarea>
  <div class="problem__hints">
    {hints.includes(1) && <div class="problem__hint" data-hint="1" hidden><p class="label">힌트{hints.length > 1 ? ' 1' : ''}</p><slot name="hint1" /></div>}
    {hints.includes(2) && <div class="problem__hint" data-hint="2" hidden><p class="label">힌트 2</p><slot name="hint2" /></div>}
    {hints.includes(3) && <div class="problem__hint" data-hint="3" hidden><p class="label">힌트 3</p><slot name="hint3" /></div>}
    <div class="problem__solution" hidden><p class="label">풀이</p><slot name="solution" /></div>
  </div>
  <div class="problem__actions">
    <button type="button" class="btn problem__more">{hints.length === 0 ? '풀이 보기' : hints.length === 1 ? '힌트 보기' : '힌트 1 보기'}</button>
  </div>
</qm-problem>

<script>
  import { getLessonNumber, readNotes, writeNotes } from '../../lib/client/bus.ts';

  class QmProblem extends HTMLElement {
    shown = 0;
    connectedCallback() {
      if (this.dataset.bound) return;
      this.dataset.bound = '1';
      const n = getLessonNumber(this);
      const note = this.querySelector<HTMLTextAreaElement>('textarea')!;
      note.value = readNotes(n).problem ?? '';
      let t: ReturnType<typeof setTimeout> | undefined;
      note.addEventListener('input', () => {
        clearTimeout(t);
        t = setTimeout(() => writeNotes(n, { problem: note.value }), 300);
      });
      this.querySelector('.problem__more')!.addEventListener('click', () => this.more());
    }

    more() {
      const btn = this.querySelector<HTMLButtonElement>('.problem__more')!;
      const total = Number(this.dataset.hints ?? 3);
      this.shown++;
      if (this.shown <= total) {
        const hint = this.querySelector<HTMLElement>(`[data-hint="${this.shown}"]`)!;
        hint.hidden = false;
        hint.scrollIntoView({ block: 'nearest' });
        btn.textContent = this.shown < total ? `힌트 ${this.shown + 1} 보기` : '풀이 보기';
      } else {
        const sol = this.querySelector<HTMLElement>('.problem__solution')!;
        sol.hidden = false;
        sol.scrollIntoView({ block: 'nearest' });
        btn.hidden = true;
      }
    }
  }
  if (!customElements.get('qm-problem')) customElements.define('qm-problem', QmProblem);
</script>

<style>
  .problem {
    display: grid;
    gap: 10px;
  }

  .problem__q :global(p + p) {
    margin-top: 0.7em;
  }

  .problem__note {
    width: 100%;
    resize: vertical;
    min-height: 72px;
    padding: 10px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--line-2);
    background: var(--ink-2);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-sm);
  }

  .problem__hints {
    display: grid;
    gap: 10px;
  }

  .problem__hint,
  .problem__solution {
    border-left: 2px solid var(--line-2);
    padding: 4px 0 4px 12px;
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .problem__solution {
    border-left-color: var(--accent);
  }
</style>
