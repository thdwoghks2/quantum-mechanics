---
/** 자기 말로 세 줄. 학습자가 먼저 쓰고, 그다음에 필자의 세 줄(slot)이 열린다. */
---
<qm-three class="three">
  <div class="three__inputs">
    {[1, 2, 3].map((i) => (
      <>
        <label class="sr-only" for={`three-${i}`}>{i}번째 줄</label>
        <input id={`three-${i}`} class="three__line" data-i={i - 1} placeholder={`${i}.`} autocomplete="off" />
      </>
    ))}
  </div>
  <button type="button" class="btn three__reveal">필자의 세 줄과 비교하기</button>
  <div class="three__author" hidden>
    <p class="label">필자의 세 줄</p>
    <slot />
  </div>
</qm-three>

<script>
  import { getLessonNumber, readNotes, writeNotes } from '../../lib/client/bus.ts';

  class QmThree extends HTMLElement {
    connectedCallback() {
      if (this.dataset.bound) return;
      this.dataset.bound = '1';
      const n = getLessonNumber(this);
      const inputs = [...this.querySelectorAll<HTMLInputElement>('.three__line')];
      const saved = readNotes(n).three;
      if (saved) inputs.forEach((el, i) => (el.value = saved[i] ?? ''));
      const persist = () => writeNotes(n, { three: inputs.map((el) => el.value) as [string, string, string] });
      inputs.forEach((el) => el.addEventListener('change', persist));
      this.querySelector('.three__reveal')!.addEventListener('click', () => {
        persist();
        this.querySelector<HTMLElement>('.three__author')!.hidden = false;
      });
    }
  }
  if (!customElements.get('qm-three')) customElements.define('qm-three', QmThree);
</script>

<style>
  .three {
    display: grid;
    gap: 12px;
  }

  .three__inputs {
    display: grid;
    gap: 8px;
  }

  .three__line {
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--ink-2);
    color: var(--text);
    font: inherit;
    font-size: var(--fs-sm);
  }

  .three__author {
    border-left: 2px solid var(--accent);
    padding-left: 12px;
    font-size: var(--fs-sm);
  }

  .three__author :global(ol) {
    margin: 4px 0 0;
    padding-left: 1.2em;
  }
</style>
