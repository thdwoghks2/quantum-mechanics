---
/**
 * 핵심 문장. 그 화면에서 꼭 가져가야 할 문장 하나를 천천히 읽히게 따로 세운다.
 * 짧게 끊지 말고 조건과 이유를 다 담은 한 문장으로 쓴다. 한 화면에 하나까지.
 */
---
<p class="key chalk"><slot /></p>

<style>
  /* 화면 가운데에 크게, 칠판에 새기듯. 글이 왼쪽부터 써지듯 드러나고, 뒤에 은은한 빛이 퍼진다. */
  .key {
    position: relative;
    margin: 10px 0 6px;
    padding: 26px 20px 24px;
    border: 1px solid rgba(228, 223, 210, 0.08);
    border-radius: var(--radius-lg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    line-height: 1.78;
    color: var(--chalk);
    text-align: center;
    text-wrap: pretty;
    text-shadow: 0 0 1px rgba(228, 223, 210, 0.35);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3), 0 24px 60px -28px rgba(231, 145, 58, 0.28);
  }

  .key::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 36px;
    height: 2px;
    margin-left: -18px;
    border-radius: 1px;
    background: var(--accent);
    opacity: 0.75;
  }

  /* 화면이 열릴 때, 또는 단계로 나타날 때 한 번 써진다. 잘라 내는 틀은 상자보다 넓게 잡아서 아래로 퍼지는 빛이 잘리지 않게 한다. */
  :global(html.js .screen.is-active) .key {
    animation: key-write 1.7s 0.25s cubic-bezier(0.45, 0, 0.2, 1) both, key-glow 3.2s 1.6s ease-in-out both;
  }

  :global(html.js .step-enter) .key {
    animation: key-write-again 1.7s 0.1s cubic-bezier(0.45, 0, 0.2, 1) both, key-glow 3.2s 1.4s ease-in-out both;
  }

  @keyframes key-write {
    from {
      clip-path: inset(-40% 100% -60% -20%);
      opacity: 0.4;
    }
    to {
      clip-path: inset(-40% -20% -60% -20%);
      opacity: 1;
    }
  }

  @keyframes key-write-again {
    from {
      clip-path: inset(-40% 100% -60% -20%);
      opacity: 0.4;
    }
    to {
      clip-path: inset(-40% -20% -60% -20%);
      opacity: 1;
    }
  }

  @keyframes key-glow {
    50% {
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3), 0 24px 70px -20px rgba(231, 145, 58, 0.42);
    }
  }

  .key :global(strong) {
    color: var(--accent-2);
  }
</style>
