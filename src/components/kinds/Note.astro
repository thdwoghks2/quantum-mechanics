---
/**
 * 옆에서 한마디. 글쓴이(저)가 잠깐 멈춰서, 헷갈리기 쉬운 곳을 다시 짚거나 한 걸음 더 풀어 줄 때 쓴다.
 * 한 강에 한두 번만 쓴다.
 */
interface Props {
  label?: string;
}
const { label = '잠깐' } = Astro.props;
---
<aside class="note">
  <p class="note__label label">{label}</p>
  <div class="note__body"><slot /></div>
</aside>

<style>
  .note {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border: 1px dashed var(--line-2);
    border-radius: var(--radius);
    background: var(--ink-2);
  }

  .note__label {
    color: var(--accent);
  }

  .note__body {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-2);
  }

  .note__body :global(p + p) {
    margin-top: 0.6em;
  }
</style>
