---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import '../styles/lesson.css';
---
<Base title="복습" description="강에서 푼 확인 문제를 1일, 3일, 7일, 21일 뒤에 다시 풀어요.">
  <main class="page" data-page="review">
    <header class="page__head">
      <p class="label">복습</p>
      <h1>오늘 다시 풀 문제</h1>
      <p class="page__lead">
        강 안에서 푼 확인 문제는 1일, 3일, 7일, 21일 뒤에 다시 나와요. 맞히면 다음 간격으로 넘어가고, 틀리면 1일 뒤로 돌아가요.
        21일 간격까지 맞히면 익힌 것으로 보고 더 내지 않아요.
      </p>
      <p class="small muted" id="stats"></p>
    </header>
    <section class="card review-card" id="item" hidden>
      <p class="label" id="item-meta"></p>
      <div id="item-body"></div>
      <div class="row">
        <button type="button" class="btn btn--primary" id="item-next" hidden>다음</button>
      </div>
    </section>
    <p class="empty" id="empty" hidden></p>
  </main>
  <script>
    import { load, recordReview, save } from '../lib/progress.ts';
    import { dueItems, isLearned } from '../lib/review.ts';
    import { isCorrect, parseNumber } from '../lib/numbers.ts';
    import { fetchCheck, type CheckPayload } from '../lib/client/checks.ts';
    import { lessonUrl } from '../lib/url.ts';

    // 사이트는 페이지를 새로 불러오지 않고 내용만 바꿔 끼운다(배경 음악이 끊기지 않게).
    // 그래서 이 페이지에 들어올 때마다 astro:page-load에서 다시 실행하고, 다른 페이지에서는 아무것도 하지 않는다.
    function init() {
      if (!document.querySelector('[data-page="review"]')) return;

      const DAY = 86_400_000;
      let queue = dueItems(Object.values(load().reviews), Date.now());
      const total = queue.length;
      let doneCount = 0;

      function stats() {
        const all = Object.values(load().reviews);
        const learned = all.filter(isLearned).length;
        const upcoming = all.filter((r) => !isLearned(r) && r.due > Date.now()).sort((a, b) => a.due - b.due)[0];
        const next = upcoming ? Math.max(1, Math.ceil((upcoming.due - Date.now()) / DAY)) : null;
        document.getElementById('stats')!.textContent =
          `복습 목록 ${all.length}문제 · 익힌 문제 ${learned}개` + (next ? ` · 다음 복습은 ${next}일 안에` : '');
      }

      function answered(id: string, ok: boolean) {
        save(recordReview(load(), id, ok, Date.now()));
        doneCount++;
        const next = document.getElementById('item-next')!;
        next.hidden = false;
        next.focus();
        stats();
      }

      async function render() {
        const box = document.getElementById('item')!;
        const empty = document.getElementById('empty')!;
        const item = queue.shift();
        if (!item) {
          box.hidden = true;
          empty.hidden = false;
          empty.textContent = total === 0
            ? '오늘 복습할 문제가 없어요. 강을 공부하면서 확인 문제를 풀면 여기에 쌓여요.'
            : `오늘 복습 ${doneCount}문제를 마쳤어요.`;
          return;
        }
        box.hidden = false;
        document.getElementById('item-next')!.hidden = true;
        document.getElementById('item-meta')!.textContent = `${item.lesson}강 · ${doneCount + 1}/${total}`;
        const body = document.getElementById('item-body')!;
        body.innerHTML = '';
        // 다른 기기에서 불러온 기록에는 문제 내용이 없다. 그 강 페이지에서 문제를 다시 읽어 와 저장해 둔다.
        let p = item.payload as CheckPayload | null;
        if (!p || !('kind' in p)) {
          body.textContent = '문제를 불러오는 중이에요…';
          p = await fetchCheck(lessonUrl(item.lesson), item.id);
          body.innerHTML = '';
          if (!p) {
            body.textContent = '이 문제를 불러오지 못했어요. 인터넷에 연결된 뒤 다시 열어 보세요.';
            const next = document.getElementById('item-next')!;
            next.hidden = false;
            return;
          }
          const s = load();
          if (s.reviews[item.id]) {
            s.reviews[item.id]!.payload = p;
            save(s);
          }
        }
        const payload = p;
        const q = document.createElement('div');
        q.className = 'check__q';
        q.innerHTML = payload.q;
        body.append(q);
        if (payload.kind === 'choice') {
          const ol = document.createElement('ol');
          ol.className = 'check__opts';
          payload.options.forEach((o) => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'check__opt';
            b.innerHTML = '<span class="check__mark" aria-hidden="true"></span>';
            b.append(o.t);
            const why = document.createElement('p');
            why.className = 'check__why';
            why.hidden = true;
            why.textContent = o.why;
            b.addEventListener('click', () => {
              ol.querySelectorAll('button').forEach((x) => (x.disabled = true));
              b.classList.add(o.ok ? 'is-ok' : 'is-no');
              why.hidden = false;
              if (!o.ok) {
                const idx = payload.options.findIndex((x) => x.ok);
                const li2 = ol.children[idx]!;
                li2.querySelector('button')!.classList.add('is-answer');
                (li2.querySelector('.check__why') as HTMLElement).hidden = false;
              }
              answered(item.id, o.ok);
            });
            li.append(b, why);
            ol.append(li);
          });
          body.append(ol);
        } else {
          const form = document.createElement('form');
          form.className = 'numeric__form';
          const input = document.createElement('input');
          input.className = 'numeric__input mono';
          input.setAttribute('aria-label', '답');
          input.inputMode = 'decimal';
          const unit = document.createElement('span');
          unit.className = 'numeric__unit mono';
          unit.textContent = payload.unit ?? '';
          const go = document.createElement('button');
          go.className = 'btn';
          go.textContent = '확인';
          form.append(input, unit, go);
          const verdict = document.createElement('p');
          verdict.className = 'numeric__verdict';
          const sol = document.createElement('div');
          sol.className = 'numeric__solution';
          sol.hidden = true;
          sol.innerHTML = payload.solution;
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const ok = isCorrect(parseNumber(input.value), payload.answer, payload.mode, payload.tol);
            verdict.className = `numeric__verdict ${ok ? 'is-ok' : 'is-no'}`;
            verdict.textContent = ok
              ? `맞았어요. 정답은 약 ${payload.answer.toLocaleString('ko-KR')}${payload.unit ? ` ${payload.unit}` : ''}이에요.`
              : `아직이에요. 정답은 약 ${payload.answer.toLocaleString('ko-KR')}${payload.unit ? ` ${payload.unit}` : ''}이에요. 아래 풀이와 비교해 보세요.`;
            sol.hidden = false;
            go.disabled = true;
            answered(item.id, ok);
          });
          body.append(form, verdict, sol);
        }
      }

      document.getElementById('item-next')!.addEventListener('click', () => void render());
      stats();
      void render();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Base>

<style>
  .review-card {
    gap: 16px;
    padding: 22px 18px;
  }
</style>
