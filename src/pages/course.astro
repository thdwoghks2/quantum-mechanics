---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import StarMap from '../components/rewards/StarMap.astro';
import YearLine from '../components/rewards/YearLine.astro';
import { getCourse } from '../lib/course.ts';
import { lessonUrl } from '../lib/url.ts';
import { stageInfo, stageLine, stageOf, stageRange } from '../lib/stage.ts';

const course = await getCourse();
const total = course.reduce((s, p) => s + p.lessons.length, 0);
---
<Base title="코스" description="0부에서 16부까지 한 줄로 이어진 137강의 지도예요.">
  <main class="page" data-page="course">
    <header class="page__head">
      <p class="label">한 줄로 이어진 {total}강</p>
      <h1>코스</h1>
      <p class="page__lead">
        0부에서 16부까지 한 줄로 이어져요. 뒤 강은 앞 강에서 배운 것만 끌어다 써요.
      </p>
    </header>

    <section class="sky-wrap" aria-labelledby="sky-h">
      <h2 id="sky-h" class="sr-only">별 지도</h2>
      <StarMap size="large" />
      <div class="sky-foot">
        <YearLine />
        <p class="small muted" id="summary"></p>
      </div>
    </section>

    <ol class="track">
      {course.map((p) => (
        <li class="track__part" id={`part-${p.number}`}>
          <div class="track__head">
            <p class="mono track__pn">{p.number}부</p>
            <h2>{p.title}</h2>
            <p class="small muted">{p.summary}</p>
            <p class="label track__stage">교육 과정: {stageRange(p.lessons.map((l) => l.n))}</p>
          </div>
          <ol class="track__lessons">
            {p.lessons.map((l) => (
              <li class:list={['node', { 'is-open': l.published }]} data-n={l.n}>
                <span class="node__dot" aria-hidden="true"></span>
                <span class="mono node__n">{String(l.n).padStart(3, '0')}</span>
                <span class="node__body">
                  {l.published ? <a href={lessonUrl(l.n)} class="node__t">{l.title}</a> : <span class="node__t">{l.title}</span>}
                  {l.note && <span class="node__note">{l.note}</span>}
                  {stageOf(l.n) && <span class="node__stage" title={stageLine(stageOf(l.n)!)}>{stageInfo(stageOf(l.n)!.stage).short}</span>}
                </span>
                <span class="node__state">{l.published ? '' : '준비 중'}</span>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </main>
  <script>
    import { load } from '../lib/progress.ts';

    // 사이트는 페이지를 새로 불러오지 않고 내용만 바꿔 끼운다(배경 음악이 끊기지 않게).
    // 그래서 이 페이지에 들어올 때마다 astro:page-load에서 다시 실행하고, 다른 페이지에서는 아무것도 하지 않는다.
    function init() {
      if (!document.querySelector('[data-page="course"]')) return;
      const LABEL: Record<string, string> = { done: '끝냄', skipped: '건너뜀', 'tested-out': '통과', started: '보는 중' };
      const state = load();
      let done = 0;
      for (const el of document.querySelectorAll<HTMLElement>('.node.is-open')) {
        const st = state.lessons[el.dataset.n!]?.status;
        if (!st) continue;
        el.dataset.status = st;
        el.querySelector('.node__state')!.textContent = LABEL[st] ?? '';
        if (st === 'done' || st === 'tested-out') done++;
      }
      const open = document.querySelectorAll('.node.is-open').length;
      document.getElementById('summary')!.textContent = `열린 ${open}강 가운데 ${done}강을 끝냈어요. 별은 끝낸 강마다 하나씩 켜져요.`;
      const next = [...document.querySelectorAll<HTMLElement>('.node.is-open')].find((el) => !el.dataset.status || el.dataset.status === 'started');
      next?.classList.add('is-next');
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Base>

<style>
  .sky-wrap {
    display: grid;
    gap: 22px;
    padding: 22px 0 6px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .sky-foot {
    display: grid;
    gap: 10px;
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 56px;
  }

  .track__head {
    display: grid;
    gap: 6px;
    padding-left: 34px;
    margin-bottom: 14px;
  }

  .track__pn {
    color: var(--accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
  }

  .track__head h2 {
    font-size: var(--fs-xl);
  }

  .track__head .small {
    line-height: 1.65;
  }

  .track__lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .track__lessons::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--line-2);
  }

  .node {
    position: relative;
    display: grid;
    grid-template-columns: 34px 2.8em minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 8px;
    padding: 11px 0;
    color: var(--muted);
  }

  .node__dot {
    position: relative;
    top: 3px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1.5px solid var(--line-2);
    background: var(--ink);
  }

  .node.is-open {
    color: var(--text);
  }

  .node.is-open .node__dot {
    border-color: var(--text-2);
  }

  .node[data-status='done'] .node__dot {
    background: var(--star);
    border-color: var(--star);
    box-shadow: 0 0 10px rgba(244, 234, 214, 0.25);
  }

  .node[data-status='tested-out'] .node__dot {
    background: color-mix(in srgb, var(--star) 55%, var(--ink));
    border-color: color-mix(in srgb, var(--star) 55%, var(--ink));
  }

  .node[data-status='skipped'] .node__dot {
    background: var(--line-2);
  }

  .node.is-next .node__dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
    animation: next-breathe 2.8s ease-in-out infinite;
  }

  @keyframes next-breathe {
    50% {
      box-shadow: 0 0 0 9px rgba(231, 145, 58, 0.06);
    }
  }

  .node__n {
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .node__body {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .node__t {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    line-height: 1.5;
  }

  a.node__t:hover {
    color: var(--accent-2);
    text-decoration: underline;
  }

  .node__note {
    font-size: var(--fs-xs);
    color: var(--muted);
    line-height: 1.55;
  }

  .node:not(.is-open) .node__note {
    opacity: 0.75;
  }

  /* 학교 교육 과정에서의 위치 (중학교, 고2·3 일반, 대학 기초 …) */
  .node__stage {
    justify-self: start;
    font-size: 10.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 5px;
    margin-top: 2px;
  }

  .track__stage {
    color: var(--accent);
  }

  .node__state {
    font-size: 0.6875rem;
    color: var(--text-2);
    white-space: nowrap;
  }

  .node:not(.is-open) .node__state {
    color: var(--muted);
    opacity: 0.7;
  }
</style>
