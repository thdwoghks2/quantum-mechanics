---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { getCourse } from '../lib/course.ts';
import { lessonUrl } from '../lib/url.ts';

const course = await getCourse();
const total = course.reduce((s, p) => s + p.lessons.length, 0);
---
<Base title="코스" description="137강 전체 궤적">
  <main class="page" data-page="course">
    <header class="page__head">
      <p class="label">한 줄로 이어진 {total}강</p>
      <h1>코스</h1>
      <p class="page__lead">
        0부에서 16부까지 한 줄로 이어진다. 앞 강에서 배운 것만 뒤 강에서 끌어다 쓴다.
        밝은 강은 공개된 강이고, 어두운 강은 준비 중이다.
      </p>
      <p class="small muted" id="summary"></p>
    </header>

    <ol class="track">
      {course.map((p) => (
        <li class="track__part">
          <div class="track__head">
            <p class="mono track__pn">{p.number}부</p>
            <h2>{p.title}</h2>
            <p class="small muted">{p.summary}</p>
          </div>
          <ol class="track__lessons">
            {p.lessons.map((l) => (
              <li class:list={['node', { 'is-open': l.published }]} data-n={l.n}>
                <span class="node__dot" aria-hidden="true"></span>
                <span class="mono node__n">{String(l.n).padStart(3, '0')}</span>
                <span class="node__body">
                  {l.published ? <a href={lessonUrl(l.n)} class="node__t">{l.title}</a> : <span class="node__t">{l.title}</span>}
                  <span class="node__note">{l.note}</span>
                </span>
                <span class="node__state small">{l.published ? '' : '준비 중'}</span>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </main>
  <script>
    import { load } from '../lib/progress.ts';

    // 사이트는 페이지를 새로 불러오지 않고 내용만 바꿔 끼운다(배경 음악이 끊기지 않게).
    // 그래서 이 페이지에 들어올 때마다 astro:page-load에서 다시 실행하고, 다른 페이지에서는 아무것도 하지 않는다.
    function init() {
      if (!document.querySelector('[data-page="course"]')) return;
      const LABEL: Record<string, string> = { done: '끝냄', skipped: '건너뜀', 'tested-out': '통과', started: '보는 중' };
      const state = load();
      let done = 0;
      for (const el of document.querySelectorAll<HTMLElement>('.node.is-open')) {
        const st = state.lessons[el.dataset.n!]?.status;
        if (!st) continue;
        el.dataset.status = st;
        el.querySelector('.node__state')!.textContent = LABEL[st] ?? '';
        if (st === 'done' || st === 'tested-out') done++;
      }
      const open = document.querySelectorAll('.node.is-open').length;
      document.getElementById('summary')!.textContent = `공개된 ${open}강 가운데 ${done}강을 끝냈다.`;
      const next = [...document.querySelectorAll<HTMLElement>('.node.is-open')].find((el) => !el.dataset.status || el.dataset.status === 'started');
      next?.classList.add('is-next');
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Base>

<style>
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 34px;
  }

  .track__head {
    display: grid;
    gap: 4px;
    padding-left: 30px;
    margin-bottom: 10px;
  }

  .track__pn {
    color: var(--accent);
    font-size: var(--fs-sm);
  }

  .track__head h2 {
    font-size: var(--fs-xl);
  }

  .track__lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .track__lessons::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line-2);
  }

  .node {
    position: relative;
    display: grid;
    grid-template-columns: 30px 3.2em minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 8px;
    padding: 8px 0;
    color: var(--muted);
  }

  .node__dot {
    position: relative;
    top: 2px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1.5px solid var(--line-2);
    background: var(--ink);
  }

  .node.is-open {
    color: var(--text);
  }

  .node.is-open .node__dot {
    border-color: var(--text-2);
  }

  .node[data-status='done'] .node__dot,
  .node[data-status='tested-out'] .node__dot {
    background: var(--text-2);
  }

  .node[data-status='skipped'] .node__dot {
    background: var(--line-2);
  }

  .node.is-next .node__dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  .node__n {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .node__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .node__t {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }

  a.node__t:hover {
    color: var(--accent-2);
    text-decoration: underline;
  }

  .node__note {
    font-size: var(--fs-xs);
    color: var(--muted);
    line-height: 1.5;
  }

  .node__state {
    color: var(--text-2);
    white-space: nowrap;
  }
</style>
