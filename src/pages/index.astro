---
import Base from '../layouts/Base.astro';
import StarMap from '../components/rewards/StarMap.astro';
import StageBar from '../components/rewards/StageBar.astro';
import '../styles/pages.css';
import { getCourse } from '../lib/course.ts';
import { lessonUrl, url } from '../lib/url.ts';
import { stageRange } from '../lib/stage.ts';

const course = await getCourse();
const all = course.flatMap((p) => p.lessons);
const published = all.filter((l) => l.published);
const partTitle = new Map(course.map((p) => [p.number, p.title]));
const meta = JSON.stringify(
  published.map((l) => ({
    n: l.n,
    title: l.title,
    q: l.question ?? '',
    min: l.minutes ?? 20,
    part: l.part,
    pt: partTitle.get(l.part) ?? '',
  })),
).replace(/</g, '\\u003c');
const first = published[0] ?? all[0]!;
---
<Base title="137">
  <main class="page home" data-page="index">
    <!-- 휴대폰 첫 화면에 "지금 무엇을 하면 되는지"가 다 들어가게: 오늘의 강, 진도, 교육 과정 위치, 복습 -->
    <p class="home__brand">양자역학을 기초부터, 하루 한 강씩</p>

    <section class="today" aria-labelledby="today-h">
      <p class="label" id="today-kicker">{first.part}부 {partTitle.get(first.part)} · 처음 시작</p>
      <h1 class="today__h" id="today-h"><span class="mono today__n" id="today-n">{first.n}강</span> <span id="today-t">{first.title}</span></h1>
      <p class="today__q" id="today-q">{first.question}</p>
      <a class="btn btn--primary today__go" id="continue" href={lessonUrl(first.n)}>시작하기</a>
      <p class="small today__alt" id="today-alt"><a href={url('placement/')}>이미 아는 게 있다면, 진단으로 시작할 강 찾기 ›</a></p>
    </section>

    <section class="prog" aria-label="진도">
      <p class="prog__row"><span id="done-line">137강 가운데 0강을 끝냈어요</span><a class="small" href={url('course/')}>전체 보기 ›</a></p>
      <ol class="prog__ticks" id="ticks" aria-hidden="true">
        {all.map((l) => <li data-n={l.n} data-part={l.part}></li>)}
      </ol>
      <StageBar n={first.n} head="교육 과정에서는" />
    </section>

    <nav class="tiles" aria-label="바로 가기">
      <a class="tile" href={url('review/')}>
        <span class="tile__k label">오늘 복습</span>
        <span class="tile__v"><span id="due-n">0</span>문제</span>
      </a>
      <a class="tile" href={url('board/')}>
        <span class="tile__k label">칠판</span>
        <span class="tile__v small">배운 식과 말 모아 보기</span>
      </a>
    </nav>

    <section class="section home-sky" aria-labelledby="sky-h">
      <p class="label" id="sky-h">내 하늘 · 끝낸 강마다 별이 하나 켜져요</p>
      <a class="home-sky__map" href={url('course/')} aria-label="코스에서 별 지도 크게 보기"><StarMap size="small" /></a>
    </section>

    <section class="section" aria-labelledby="parts-h">
      <p class="label" id="parts-h">17부 · 누르면 그 부로 가요</p>
      <ol class="chips">
        {course.map((p) => (
          <li>
            <a class="chip" href={url(`course/#part-${p.number}`)} data-part={p.number} data-ns={p.lessons.map((l) => l.n).join(',')}
              title={`${p.number}부 ${p.title} · 교육 과정: ${stageRange(p.lessons.map((l) => l.n))}`}>
              <span class="mono chip__n">{p.number}부</span>
              <span class="chip__t">{p.title}</span>
              <span class="chip__c mono" data-count>0/{p.lessons.length}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="section mores">
    <details class="more">
      <summary><h2>이렇게 같이 공부해요</h2></summary>
      <ol class="how">
        <li>
          <p class="how__t">화면을 한 장씩 넘겨요</p>
          <p class="muted small">화면마다 그림이나 시뮬레이션 하나와 글 몇 줄이 있어요. 휴대폰 한 화면에 들어가는 만큼이에요. 한 강은 20분 안팎이에요.</p>
        </li>
        <li>
          <p class="how__t">용어는 배운 다음에만 써요</p>
          <p class="muted small">새 용어는 그 강에서 뜻을 정하고 예를 들어요. 밑줄 친 말을 누르면 보던 화면 그대로 아래에서 뜻이 올라와요.</p>
        </li>
        <li>
          <p class="how__t">끝에서 한 번 되짚어요</p>
          <p class="muted small">강 끝에서 오늘 나온 말과 생각이 흘러온 길을 모아 보고, 짧은 문제 하나로 점검해요.</p>
        </li>
        <li>
          <p class="how__t">푼 문제는 다시 돌아와요</p>
          <p class="muted small">강 안에서 푼 확인 문제는 1일, 3일, 7일, 21일 뒤에 복습으로 다시 나와요. 틀리면 1일부터 다시 시작해요.</p>
        </li>
        <li>
          <p class="how__t">기록은 저절로 남아요</p>
          <p class="muted small">어디까지 봤는지, 푼 문제, 적어 둔 메모가 이 기기에 저장돼요. <a href={url('settings/')}>기록</a>에서 짧은 글이나 파일로 내보내면 다른 기기에서도 이어 볼 수 있어요.</p>
        </li>
      </ol>
    </details>

    <details class="more">
      <summary><h2>왜 137일까요</h2></summary>
      <p class="muted">
        빛과 전자가 서로 얼마나 세게 끌어당기고 밀어내는지를 나타내는 수가 있어요. 그 값이 거의 정확히 137분의 1이에요.
        왜 하필 이 값인지는 아직 아무도 몰라요. 리처드 파인먼은 이 수를 물리학의 가장 큰 수수께끼 가운데 하나로 꼽았어요.
        이 책의 강 수는 그 수에서 따왔고, 그 수가 정확히 무엇인지는 122강에서 같이 볼 거예요.
      </p>
    </details>
    </div>
  </main>
  <script type="application/json" id="published" set:html={meta} />
  <script>
    import { load, nextLesson } from '../lib/progress.ts';
    import { dueItems } from '../lib/review.ts';

    // 사이트는 페이지를 새로 불러오지 않고 내용만 바꿔 끼운다(배경 음악이 끊기지 않게).
    // 그래서 이 페이지에 들어올 때마다 astro:page-load에서 다시 실행하고, 다른 페이지에서는 아무것도 하지 않는다.
    function init() {
      if (!document.querySelector('[data-page="index"]')) return;
      interface Meta { n: number; title: string; q: string; min: number; part: number; pt: string }
      const published: Meta[] = JSON.parse(document.getElementById('published')!.textContent!);
      const state = load();
      const $ = (id: string) => document.getElementById(id)!;
      const isDone = (n: number) => ['done', 'tested-out'].includes(state.lessons[n]?.status ?? '');
      const n = nextLesson(state, published.map((p) => p.n));
      const started = Object.keys(state.lessons).length > 0;
      const btn = $('continue') as HTMLAnchorElement;

      // 오늘의 강
      const t = published.find((p) => p.n === n);
      if (t) {
        const rec = state.lessons[t.n];
        const screen = rec?.status === 'started' ? rec.screen : undefined;
        $('today-kicker').textContent = `${t.part}부 ${t.pt} · ${started ? '오늘의 강' : '처음 시작'}`;
        $('today-n').textContent = `${t.n}강`;
        $('today-t').textContent = t.title;
        $('today-q').textContent = t.q;
        btn.href = btn.href.replace(/lessons\/\d+\/(#.*)?$/, `lessons/${t.n}/`);
        btn.textContent = screen ? `이어 보기 · ${screen + 1}번째 화면부터 (약 ${t.min}분)` : `${started ? '시작하기' : '1강부터 시작하기'} (약 ${t.min}분)`;
        if (started) $('today-alt').hidden = true;
        (window as unknown as { paintStage?: (r: HTMLElement, n: number, h?: string) => void }).paintStage?.(
          document.querySelector<HTMLElement>('.prog [data-stagebar]')!,
          t.n,
        );
      } else if (started) {
        $('today-kicker').textContent = '열린 강을 모두 마쳤어요';
        $('today-n').textContent = '';
        $('today-t').textContent = '137강을 다 읽었어요';
        $('today-q').textContent = '코스에서 다시 보고 싶은 강을 골라 보세요. 복습 문제는 계속 돌아와요.';
        btn.textContent = '코스 보기';
        btn.href = btn.href.replace(/lessons\/\d+\/$/, '../course/');
      }

      // 진도: 137칸
      let done = 0;
      document.querySelectorAll<HTMLElement>('#ticks li').forEach((li) => {
        const k = Number(li.dataset.n);
        const st = state.lessons[k]?.status;
        li.className = isDone(k) ? 'is-done' : st === 'skipped' ? 'is-skip' : k === n ? 'is-next' : '';
        if (isDone(k)) done++;
      });
      $('done-line').textContent = `137강 가운데 ${done}강을 끝냈어요`;

      // 부별 끝낸 수
      document.querySelectorAll<HTMLElement>('.chip').forEach((chip) => {
        const ns = chip.dataset.ns!.split(',').map(Number);
        const d = ns.filter(isDone).length;
        chip.querySelector('[data-count]')!.textContent = `${d}/${ns.length}`;
        chip.classList.toggle('is-here', n !== undefined && ns.includes(n));
        chip.classList.toggle('is-done', d === ns.length);
      });

      $('due-n').textContent = String(dueItems(Object.values(state.reviews), Date.now()).length);
    }
    document.addEventListener('astro:page-load', init);
  </script>
</Base>

<style>
  /* 휴대폰 첫 화면(390×844)에 이름, 오늘의 강, 진도, 교육 과정 위치, 복습이 다 들어가게 촘촘히. */
  .home {
    gap: 24px;
    padding-top: 22px;
    padding-bottom: 48px;
  }

  .home > .section {
    padding-top: 20px;
  }

  .home__brand {
    font-size: var(--fs-sm);
    color: var(--text-2);
    margin-bottom: -10px;
  }

  .today {
    display: grid;
    gap: 10px;
    padding: 18px 18px 16px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 9%, var(--ink-2)), var(--ink-2) 60%);
  }

  .today__h {
    font-size: clamp(1.45rem, 6vw, 1.9rem);
    line-height: 1.25;
  }

  .today__n {
    color: var(--accent);
    font-size: 0.7em;
    vertical-align: 0.15em;
    margin-right: 2px;
  }

  .today__q {
    color: var(--text-2);
    line-height: 1.6;
  }

  .today__go {
    justify-content: center;
    min-height: 50px;
    font-size: 1rem;
    margin-top: 4px;
  }

  .today__alt {
    text-align: center;
  }

  .prog {
    display: grid;
    gap: 10px;
  }

  .prog__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    font-size: var(--fs-sm);
  }

  /* 137칸 진도: 한 칸이 한 강 */
  .prog__ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(46, minmax(0, 1fr));
    gap: 2px;
  }

  .prog__ticks li {
    height: 7px;
    border-radius: 1px;
    background: var(--ink-3);
  }

  .prog__ticks li:global(.is-done) {
    background: var(--accent);
  }

  .prog__ticks li:global(.is-skip) {
    background: color-mix(in srgb, var(--accent) 30%, var(--ink-3));
  }

  .prog__ticks li:global(.is-next) {
    background: var(--text);
    box-shadow: 0 0 6px var(--text);
  }

  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tile {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    color: var(--text);
    text-decoration: none;
  }

  .tile__v {
    font-size: var(--fs-lg);
    font-weight: 600;
  }

  .tile__v.small {
    font-size: var(--fs-sm);
    font-weight: 400;
    color: var(--text-2);
  }

  .home-sky {
    gap: 10px;
  }

  .home-sky__map {
    display: block;
    max-height: 104px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .chip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink-2);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-sm);
  }

  .chip__n {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .chip__t {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chip__c {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .chip:global(.is-here) {
    border-color: var(--accent);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .chip:global(.is-here) .chip__n {
    color: var(--accent);
  }

  .chip:global(.is-done) .chip__c {
    color: var(--accent);
  }

  .mores {
    gap: 0;
    padding-top: 6px;
  }

  .more {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .more[open] > :not(summary) {
    margin-top: 12px;
  }

  .more summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary::after {
    content: '＋';
    color: var(--muted);
  }

  .more[open] summary::after {
    content: '－';
  }

  .more summary h2 {
    font-size: var(--fs-md);
    font-weight: 600;
  }

  .how {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    counter-reset: how;
  }

  .how li {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    column-gap: 10px;
    counter-increment: how;
  }

  .how li::before {
    content: counter(how, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: var(--fs-sm);
    padding-top: 3px;
  }

  .how__t {
    font-weight: 600;
  }
</style>
